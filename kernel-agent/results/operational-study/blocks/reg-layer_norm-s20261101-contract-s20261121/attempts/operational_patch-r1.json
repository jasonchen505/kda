{"api_audit":{"message":"","missing_language_symbols":[],"scope":"Direct imported language aliases only; not full compilation or type proof","status":"api_admitted","used_language_symbols":["arange","constexpr","float32","load","program_id","sqrt","store","sum","where"]},"code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _layer_norm_kernel(\n    X,\n    Y,\n    W,\n    B,\n    stride_x,\n    stride_y,\n    N,\n    eps,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    x_ptr = X + row * stride_x\n    y_ptr = Y + row * stride_y\n    cols = tl.arange(0, BLOCK_SIZE)\n    mask = cols < N\n    x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\n    w = tl.load(W + cols, mask=mask, other=0.0).to(tl.float32)\n    b = tl.load(B + cols, mask=mask, other=0.0).to(tl.float32)\n    mean = tl.sum(x, axis=0) / N\n    centered = tl.where(mask, x - mean, 0.0)\n    var = tl.sum(centered * centered, axis=0) / N\n    rstd = 1.0 / tl.sqrt(var + eps)\n    y = centered * rstd * w + b\n    tl.store(y_ptr + cols, y.to(Y.dtype.element_ty), mask=mask)\n\n\ndef run(x, weight, bias):\n    assert x.is_cuda and x.dim() == 2\n    R, W = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(W)\n    grid = (R,)\n    _layer_norm_kernel[grid](\n        x, out, weight, bias,\n        x.stride(0), out.stride(0),\n        W, 1e-5,\n        BLOCK_SIZE=BLOCK_SIZE,\n    )\n    return out\n","diagnosis":{"coordinate_witnesses":[],"probe_relations":[],"route":"api_or_compile","scope":"Evidence-derived repair hints. No task-ID dispatch, generated reference, or automatic kernel edit.","status":"compile_error"},"draft":"Replace OUT_DTYPE constexpr with Y pointer. Cast store value to Y pointer element type. Remove OUT_DTYPE argument from kernel call.","evaluation":{"checks_passed":28,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-operational-experiment-v1/gpu4.lock","pid":2861567,"scope":"serializes t
{"api_audit":{"message":"","missing_language_symbols":[],"scope":"Direct imported language aliases only; not full compilation or type proof","status":"api_admitted","used_language_symbols":["arange","constexpr","float32","load","program_id","store","zeros"]},"code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _sum_rows_kernel(\n    X,\n    Y,\n    rows,\n    width,\n    BLOCK_SIZE: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    cols = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n    mask = cols < width\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for r in range(rows):\n        ptr = X + r * width + cols\n        val = tl.load(ptr, mask=mask, other=0.0).to(tl.float32)\n        acc += val\n    tl.store(Y + cols, acc, mask=mask)\n\n\ndef run(x):\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, width = x.shape\n    y = torch.empty((width,), dtype=x.dtype, device=x.device)\n    BLOCK_SIZE = 1024\n    grid = (triton.cdiv(width, BLOCK_SIZE),)\n    _sum_rows_kernel[grid](x, y, rows, width, BLOCK_SIZE=BLOCK_SIZE)\n    return y\n","draft":"Fix empty_like misuse by using torch.empty. Keep 1D grid over column blocks; each program sums all rows for its column slice in FP32, then stores once. Mask odd widths.","evaluation":{"checks_passed":28,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-operational-experiment-v1/gpu4.lock","pid":2885924,"scope":"serializes this project's workers only","wait_seconds":5.0187110900878906e-05},"device_audit":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"device_binding":{"actual":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"child_visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50","expected_gpu_index":4,"expected_uuid":"GPU-c3d8e
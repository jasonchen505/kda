{"attempts":[{"api_audit":{"message":"","missing_language_symbols":[],"scope":"Direct imported language aliases only; not full compilation or type proof","status":"api_admitted","used_language_symbols":["arange","constexpr","float32","load","program_id","sqrt","store","sum","zeros"]},"code":"import torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _l2_norm_kernel(\n    X,  # pointer to input\n    Y,  # pointer to output\n    stride,  # row stride\n    N,  # width\n    eps,  # epsilon\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    Y += row * stride\n\n    # Compute sum of squares\n    sum_sq = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        x = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n        sum_sq += x * x\n\n    total_sum = tl.sum(sum_sq, axis=0)\n    rstd = 1.0 / tl.sqrt(total_sum + eps)\n\n    # Scale and store\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        x = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n        y = x * rstd\n        tl.store(Y + cols, y, mask=mask)\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda\n    assert x.is_contiguous()\n    assert x.dim() == 2\n\n    rows, width = x.shape\n    y = torch.empty_like(x)\n\n    BLOCK_SIZE = 1024\n    grid = (rows,)\n\n    _l2_norm_kernel[grid](\n        x, y, x.stride(0), width, 1e-6, BLOCK_SIZE\n    )\n\n    return y\n","draft":"L2 norm via sum-of-squares. Load row, square, sum, rsqrt, scale, store. Handle odd widths with masking. Cast to input dtype once.","evaluation":{"checks_passed":28,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-operational-experiment-v1/gpu4.lock","pid":2902902,"scope":"serializes this project's workers only","wait_seconds":4.560502249747515},"device_audit":{"device_co
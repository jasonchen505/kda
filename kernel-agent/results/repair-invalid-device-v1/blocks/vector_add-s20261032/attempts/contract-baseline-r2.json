{"code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef add_kernel(x_ptr, y_ptr, output_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n    pid = tl.program_id(axis=0)\n    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n    mask = offsets < n_elements\n    x = tl.load(x_ptr + offsets, mask=mask, other=0.0).to(tl.float32)\n    y = tl.load(y_ptr + offsets, mask=mask, other=0.0).to(tl.float32)\n    out = (x + y).to(output_ptr.dtype.element_ty)\n    tl.store(output_ptr + offsets, out, mask=mask)\n\n\ndef run(x: torch.Tensor, y: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and y.is_cuda\n    assert x.shape == y.shape\n    assert x.is_contiguous() and y.is_contiguous()\n    assert x.dtype in (torch.float32, torch.bfloat16)\n    output = torch.empty_like(x)\n    n_elements = x.numel()\n    if n_elements <= 4096:\n        block_size = 256\n    elif n_elements <= 32768:\n        block_size = 1024\n    elif n_elements <= 262144:\n        block_size = 2048\n    else:\n        block_size = 4096\n    grid = lambda meta: (triton.cdiv(n_elements, meta['BLOCK_SIZE']),)\n    add_kernel[grid](x, y, output, n_elements, BLOCK_SIZE=block_size)\n    return output\n","draft":"Keep FP32 add, cast to input dtype. Tune block size per size/dtype to beat torch.compile on worst shapes.","evaluation":{"checks_passed":28,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-repair-experiment-v1/gpu4.lock","pid":2332346,"scope":"serializes this project's workers only","wait_seconds":4.894286394119263e-05},"gpu":"NVIDIA GeForce RTX 4090","measurement_condition":"shared_observed","resource_audit":{"after":{"free_mib":24199,"observed_utc":"2026-10-15T12:16:29.333523+00:00","pids":[],"power_watts":23.71,"sm_clock_mhz":210,"used_mib":12,"utilization_percent":0},"before":{"free_mib":24199,"observed_utc":"2026-10-15T12:15:48.536992+00:00","pids":[],"power_watts":23.91,"sm_clock_mhz":210,"used_mib":12,"utilization_percent":0},"gpu_index":4,"mini
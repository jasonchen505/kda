{"code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _row_mean_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n    OUT_DTYPE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        a = tl.load(X + cols, mask=mask, other=0.0).to(tl.float32)\n        acc += a\n    total = tl.sum(acc, axis=0)\n    mean = total / N\n    tl.store(Y + row, mean.to(OUT_DTYPE))\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, width = x.shape\n    out = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    if rows == 0 or width == 0:\n        return out\n    BLOCK_SIZE = triton.next_power_of_2(width)\n    grid = (rows,)\n    out_dtype = tl.bfloat16 if x.dtype == torch.bfloat16 else tl.float32\n    _row_mean_kernel[grid](x, out, width, width, BLOCK_SIZE=BLOCK_SIZE, OUT_DTYPE=out_dtype)\n    return out\n","draft":"Hypothesis: the prior kernel's pointer arithmetic or launch metadata was inconsistent with the witness, causing a 1.0 relative error on one row. Contradiction: expected row-1 mean is 1.6667 but actual differed by 0.387. Verified offsets: row r, col c -> flat r*W+c; row 1 col 2 -> 5. Output row r -> flat r. Padded lanes masked to 0; divide by actual W.","evaluation":{"checks_passed":28,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-repair-experiment-v1/gpu4.lock","pid":2329123,"scope":"serializes this project's workers only","wait_seconds":10.62416921183467},"gpu":"NVIDIA GeForce RTX 4090","measurement_condition":"shared_observed","resource_audit":{"after":{"free_mib":24199,"observed_utc":"2026-10-15T12:13:56.090861+00:00","pids":[],"power_watts":23.7,"sm_clock_mhz":210,"used_mib":12,"utilization_percent":0},"before":{"free_mi
{"code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _row_mean_kernel(\n    X,\n    Y,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    base = X + row * N\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        a = tl.load(base + cols, mask=mask, other=0.0).to(tl.float32)\n        acc += a\n    s = tl.sum(acc, axis=0)\n    mean = s / N\n    tl.store(Y + row, mean)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, cols = x.shape\n    out = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    if rows == 0 or cols == 0:\n        return out\n    if cols <= 256:\n        BLOCK_SIZE = 256\n    elif cols <= 1024:\n        BLOCK_SIZE = 1024\n    else:\n        BLOCK_SIZE = 2048\n    _row_mean_kernel[(rows,)](x, out, cols, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n","draft":"Single fused kernel: one program per row, loop over width in power-of-two blocks, accumulate FP32 sum, divide by actual width, store to output pointer (dtype auto-cast). No scratch, no atomic, no torch.dtype arg.","evaluation":{"checks_passed":28,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-repair-experiment-v1/gpu4.lock","pid":2340841,"scope":"serializes this project's workers only","wait_seconds":4.400685429573059e-05},"gpu":"NVIDIA GeForce RTX 4090","measurement_condition":"shared_observed","resource_audit":{"after":{"free_mib":24199,"observed_utc":"2026-10-15T12:23:52.834204+00:00","pids":[],"power_watts":23.62,"sm_clock_mhz":210,"used_mib":12,"utilization_percent":0},"before":{"free_mib":24199,"observed_utc":"2026-10-15T12:23:20.435583+00:00","pids":[],"power_watts":23.92,"sm_clock_mhz":210,"used_mib":12,"utilization_percent":0},"gpu_index":4,"minimum_free_mib":1024,"policy":"shared_observed","sample_period_seco
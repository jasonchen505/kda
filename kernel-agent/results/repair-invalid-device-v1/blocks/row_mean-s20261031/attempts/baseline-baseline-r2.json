{"code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _row_mean_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        a = tl.load(X + cols, mask=mask, other=0.0).to(tl.float32)\n        acc += a\n    total = tl.sum(acc, axis=0)\n    mean = total / N\n    tl.store(Y + row, mean)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, width = x.shape\n    out = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    if rows == 0 or width == 0:\n        return out\n    BLOCK_SIZE = 1024\n    grid = (rows,)\n    _row_mean_kernel[grid](x, out, width, width, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n","draft":"Single-pass row mean. Use a fixed 1024-wide block to avoid per-shape recompiles and reduce launch overhead. Accumulate in FP32, divide by actual width, store in input dtype.","evaluation":{"checks_passed":28,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-repair-experiment-v1/gpu4.lock","pid":2335579,"scope":"serializes this project's workers only","wait_seconds":0.30061279982328415},"gpu":"NVIDIA GeForce RTX 4090","measurement_condition":"shared_observed","resource_audit":{"after":{"free_mib":24199,"observed_utc":"2026-10-15T12:19:00.726593+00:00","pids":[],"power_watts":23.86,"sm_clock_mhz":210,"used_mib":12,"utilization_percent":0},"before":{"free_mib":24199,"observed_utc":"2026-10-15T12:18:16.035542+00:00","pids":[],"power_watts":23.62,"sm_clock_mhz":210,"used_mib":12,"utilization_percent":0},"gpu_index":4,"minimum_free_mib":1024,"policy":"shared_observed","sample_period_seconds":0.5,"samples":[{"free_mib":24199,"observed_utc":"2026-10-15T12:18:16.601668+00:00","pids":[],"power_watts
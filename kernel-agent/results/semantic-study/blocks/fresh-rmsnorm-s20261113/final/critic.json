{"attempts":[{"code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _rmsnorm_kernel(\n    X,\n    Y,\n    W,\n    stride,\n    N,\n    eps,\n    BLOCK_SIZE: tl.constexpr,\n    IS_BF16: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    Y += row * stride\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n        acc += a * a\n    mean_sq = tl.sum(acc, axis=0) / N\n    rstd = tl.rsqrt(mean_sq + eps)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n        norm = a * rstd\n        if IS_BF16:\n            norm = norm.to(tl.bfloat16)\n        else:\n            norm = norm.to(tl.float32)\n        w = tl.load(W + cols, mask=mask)\n        y = w * norm\n        tl.store(Y + cols, y, mask=mask)\n\n\ndef run(x, weight):\n    rows, width = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(width)\n    is_bf16 = x.dtype == torch.bfloat16\n    grid = (rows,)\n    _rmsnorm_kernel[grid](\n        x,\n        out,\n        weight,\n        width,\n        width,\n        1e-6,\n        BLOCK_SIZE=BLOCK_SIZE,\n        IS_BF16=is_bf16,\n    )\n    return out\n","draft":"RMSNorm: one program per row. Loop width in power-of-two blocks, accumulate x^2 in fp32, rstd=rsqrt(mean+eps). Cast normalized to input dtype, multiply by weight, store.","evaluation":{"checks_passed":28,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-semantic-experiment-v1/gpu4.lock","pid":2554495,"scope":"serializes this project's workers only","wait_seconds":5.9518963098526e-05},"device_audit":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-
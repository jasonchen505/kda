rt(mean+eps). Cast normalized to input dtype, multiply by weight, store.\",\"plan\":\"Allocate contiguous output. Launch grid=(rows,). Kernel: load x fp32, sum squares, rstd, normalize, cast to x dtype, multiply weight, store masked.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _rmsnorm_kernel(\",\"    X,\",\"    Y,\",\"    W,\",\"    stride,\",\"    N,\",\"    eps,\",\"    BLOCK_SIZE: tl.constexpr,\",\"    IS_BF16: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    X += row * stride\",\"    Y += row * stride\",\"    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\",\"    for off in range(0, N, BLOCK_SIZE):\",\"        cols = off + tl.arange(0, BLOCK_SIZE)\",\"        mask = cols < N\",\"        a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\",\"        acc += a * a\",\"    mean_sq = tl.sum(acc, axis=0) / N\",\"    rstd = tl.rsqrt(mean_sq + eps)\",\"    for off in range(0, N, BLOCK_SIZE):\",\"        cols = off + tl.arange(0, BLOCK_SIZE)\",\"        mask = cols < N\",\"        a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\",\"        norm = a * rstd\",\"        if IS_BF16:\",\"            norm = norm.to(tl.bfloat16)\",\"        else:\",\"            norm = norm.to(tl.float32)\",\"        w = tl.load(W + cols, mask=mask)\",\"        y = w * norm\",\"        tl.store(Y + cols, y, mask=mask)\",\"\",\"\",\"def run(x, weight):\",\"    rows, width = x.shape\",\"    out = torch.empty_like(x)\",\"    BLOCK_SIZE = triton.next_power_of_2(width)\",\"    is_bf16 = x.dtype == torch.bfloat16\",\"    grid = (rows,)\",\"    _rmsnorm_kernel[grid](\",\"        x,\",\"        out,\",\"        weight,\",\"        width,\",\"        width,\",\"        1e-6,\",\"        BLOCK_SIZE=BLOCK_SIZE,\",\"        IS_BF16=is_bf16,\",\"    )\",\"    return out\"]}","request_id":"initial","source_sha256":"d50c8d4d36442eb1d4b5aae56677b0a25d8ef54044c2afddd0bff843c4243f27"},{"code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _rmsnorm_kernel(\n    X,\n    Y,\n    W,\n    stride,\n    N,\n    eps,\n    BLOCK_SIZE: tl.constexpr,\n    IS_BF16: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    Y += row * stride\n    cols = tl.arange(0, BLOCK_SIZE)\n    mask = cols < N\n    a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n    sum_sq = tl.sum(a * a, axis=0)\n    mean_sq = sum_sq / N\n    rstd = tl.rsqrt(mean_sq + eps)\n    norm = a * rstd\n    if IS_BF16:\n        norm = norm.to(tl.bfloat16)\n    else:\n        norm = norm.to(tl.float32)\n    w = tl.load(W + cols, mask=mask)\n    y = w * norm\n    tl.store(Y + cols, y, mask=mask)\n\n\ndef run(x, weight):\n    rows, width = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(width)\n    is_bf16 = x.dtype == torch.bfloat16\n    grid = (rows,)\n    _rmsnorm_kernel[grid](\n        x,\n        out,\n        weight,\n        width,\n        width,\n        1e-6,\n        BLOCK_SIZE=BLOCK_SIZE,\n        IS_BF16=is_bf16,\n    )\n    return out\n","draft":"Fuse RMSNorm into a single pass: load each row once, accumulate sum-of-squares in FP32, compute rstd, then normalize, cast to input dtype, multiply by weight, and store. Use a single BLOCK_SIZE = next_pow2(width) to avoid loop overhead for small widths. Keep the intermediate cast before weight multiplication.","evaluation":{"checks_passed":28,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-semantic-experiment-v1/gpu4.lock","pid":2561257,"scope":"serializes this project's workers only","wait_seconds":3.1567188911139965},"device_audit":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"device_binding":{"actual":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"child_v
s) and select num_warps from cols thresholds. Allocate out=torch.empty_like(x), launch grid=(rows,), return out.","proposed_code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    out_ptr,\n    in_ptr,\n    in_row_stride,\n    out_row_stride,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    in_row = in_ptr + row * in_row_stride\n    out_row = out_ptr + row * out_row_stride\n    offs = tl.arange(0, BLOCK_SIZE)\n    mask = offs < n_cols\n    x = tl.load(in_row + offs, mask=mask, other=-float('inf')).to(tl.float32)\n    m = tl.max(x, axis=0)\n    e = tl.exp(x - m)\n    d = tl.sum(e, axis=0)\n    y = e / d\n    tl.store(out_row + offs, y, mask=mask)\n\n\ndef _next_pow2(n):\n    p = 1\n    while p < n:\n        p *= 2\n    return p\n\n\ndef _pick_warps(cols):\n    if cols <= 128:\n        return 1\n    if cols <= 512:\n        return 2\n    if cols <= 1024:\n        return 4\n    return 8\n\n\ndef run(x):\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = _next_pow2(cols)\n    num_warps = _pick_warps(cols)\n    grid = (rows,)\n    _softmax_kernel[grid](\n        out,\n        x,\n        x.stride(0),\n        out.stride(0),\n        cols,\n        BLOCK_SIZE=BLOCK_SIZE,\n        num_warps=num_warps,\n    )\n    return out\n","reply":"{\"draft\":\"Single-row-per-CTA softmax. Tune num_warps by cols: 1 for <=128, 2 for <=512, 4 for <=1024, 8 for 2048. Keep FP32 math, masked load/store, fresh contiguous out.\",\"plan\":\"Keep kernel identical. In run, compute BLOCK_SIZE=next_pow2(cols) and select num_warps from cols thresholds. Allocate out=torch.empty_like(x), launch grid=(rows,), return out.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _softmax_kernel(\",\"    out_ptr,\",\"    in_ptr,\",\"    in_row_stride,\",\"    out_row_stride,\",\"    n_cols,\",\"    BLOCK_SIZE: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    in_row = in_ptr + row * in_row_stride\",\"    out_row = out_ptr + row * out_row_stride\",\"    offs = tl.arange(0, BLOCK_SIZE)\",\"    mask = offs < n_cols\",\"    x = tl.load(in_row + offs, mask=mask, other=-float('inf')).to(tl.float32)\",\"    m = tl.max(x, axis=0)\",\"    e = tl.exp(x - m)\",\"    d = tl.sum(e, axis=0)\",\"    y = e / d\",\"    tl.store(out_row + offs, y, mask=mask)\",\"\",\"\",\"def _next_pow2(n):\",\"    p = 1\",\"    while p < n:\",\"        p *= 2\",\"    return p\",\"\",\"\",\"def _pick_warps(cols):\",\"    if cols <= 128:\",\"        return 1\",\"    if cols <= 512:\",\"        return 2\",\"    if cols <= 1024:\",\"        return 4\",\"    return 8\",\"\",\"\",\"def run(x):\",\"    assert x.is_cuda\",\"    assert x.dim() == 2\",\"    assert x.is_contiguous()\",\"    rows, cols = x.shape\",\"    out = torch.empty_like(x)\",\"    BLOCK_SIZE = _next_pow2(cols)\",\"    num_warps = _pick_warps(cols)\",\"    grid = (rows,)\",\"    _softmax_kernel[grid](\",\"        out,\",\"        x,\",\"        x.stride(0),\",\"        out.stride(0),\",\"        cols,\",\"        BLOCK_SIZE=BLOCK_SIZE,\",\"        num_warps=num_warps,\",\"    )\",\"    return out\"]}","request_id":"rewrite-r2","source_sha256":"a9532ceb4e46e374d67276f5f97824ef08de6ebb343b789f683480117b57f949"}],"correct":true,"final":{"checks_passed":28,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-semantic-experiment-v1/gpu4.lock","pid":2593994,"scope":"serializes this project's workers only","wait_seconds":4.4018030166625977e-05},"device_audit":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"device_binding":{"actual":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"chi
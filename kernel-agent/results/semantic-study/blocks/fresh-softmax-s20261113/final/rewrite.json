:[{"dtype":"torch.float32","shape":[3,4],"stride":[4,1],"values":[-2.0,-1.5,-1.0,-0.5,0.0,0.5,1.0,1.5,2.0,2.5,-2.75,-2.25],"values_truncated":false}],"phase":"search_only"}],"source_sha256":"4579b797ecefa15a3460a3b92124bca1f3d22483f7605d81426e9e89568225f1","status":"correct","timings":[{"candidate_us":1.25635857693851,"compiled_us":1.270338660106063,"dtype":"bfloat16","orders":[["compiled","candidate"],["compiled","candidate"],["compiled","candidate"]],"samples_us":{"candidate":[1.249820925295353,1.25635857693851,1.2638031039386988],"compiled":[1.2724718544632196,1.270338660106063,1.2674571480602026]},"shape":[7,257]},{"candidate_us":1.537277246825397,"compiled_us":2.079110126942396,"dtype":"bfloat16","orders":[["compiled","candidate"],["compiled","candidate"],["candidate","compiled"]],"samples_us":{"candidate":[1.5438073314726353,1.5370964538305998,1.537277246825397],"compiled":[2.079110126942396,2.071285154670477,2.081011887639761]},"shape":[128,1536]},{"candidate_us":1.7973954090848565,"compiled_us":2.706055762246251,"dtype":"bfloat16","orders":[["candidate","compiled"],["compiled","candidate"],["compiled","candidate"]],"samples_us":{"candidate":[1.7973954090848565,1.7976161325350404,1.7902683466672897],"compiled":[2.706055762246251,2.702658995985985,2.7291737496852875]},"shape":[256,2048]}],"torch":"2.6.0+cu124"},"parent_sha256":"59c2806c495e9fc697c81a7295e1f6e815ba7d58fd75fed24da380d0a3b3fdce","plan":"Allocate contiguous out. Launch grid rows. Kernel loads row masked, FP32 max/exp/sum, stores. Tune num_warps: 4 for <=1024, 8 for 2048.","proposed_code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    out_ptr,\n    in_ptr,\n    in_row_stride,\n    out_row_stride,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    in_row = in_ptr + row * in_row_stride\n    out_row = out_ptr + row * out_row_stride\n    offs = tl.arange(0, BLOCK_SIZE)\n    mask = offs < n_cols\n    x = tl.load(in_row + offs, mask=mask, other=-float('inf')).to(tl.float32)\n    m = tl.max(x, axis=0)\n    e = tl.exp(x - m)\n    d = tl.sum(e, axis=0)\n    y = e / d\n    tl.store(out_row + offs, y, mask=mask)\n\n\ndef _next_pow2(n):\n    p = 1\n    while p < n:\n        p *= 2\n    return p\n\n\ndef run(x):\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = _next_pow2(cols)\n    num_warps = 8 if BLOCK_SIZE >= 2048 else 4\n    grid = (rows,)\n    _softmax_kernel[grid](\n        out,\n        x,\n        x.stride(0),\n        out.stride(0),\n        cols,\n        BLOCK_SIZE=BLOCK_SIZE,\n        num_warps=num_warps,\n    )\n    return out\n","reply":"{\"draft\":\"Keep single-row-per-program softmax. Use num_warps tuned by block size to cut launch/occupancy overhead on small rows.\",\"plan\":\"Allocate contiguous out. Launch grid rows. Kernel loads row masked, FP32 max/exp/sum, stores. Tune num_warps: 4 for <=1024, 8 for 2048.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _softmax_kernel(\",\"    out_ptr,\",\"    in_ptr,\",\"    in_row_stride,\",\"    out_row_stride,\",\"    n_cols,\",\"    BLOCK_SIZE: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    in_row = in_ptr + row * in_row_stride\",\"    out_row = out_ptr + row * out_row_stride\",\"    offs = tl.arange(0, BLOCK_SIZE)\",\"    mask = offs < n_cols\",\"    x = tl.load(in_row + offs, mask=mask, other=-float('inf')).to(tl.float32)\",\"    m = tl.max(x, axis=0)\",\"    e = tl.exp(x - m)\",\"    d = tl.sum(e, axis=0)\",\"    y = e / d\",\"    tl.store(out_row + offs, y, mask=mask)\",\"\",\"\",\"def _next_pow2(n):\",\"    p = 1\",\"    while p < n:\",\"        p *= 2\",\"    return p\",\"\",\"\",\"def run(x):\",\"    assert x.is_cuda\",\"    assert x.dim() == 2\",\"    assert x.is_contiguous()\",\"    rows, cols = x.shape\",\"    out = torch.empty_like(x)\",\"    BLOCK_SIZE = _next_pow2(cols)\",\"    num_warps = 8 if BLOCK_SIZE >= 2048 else 4\",\"    grid = (rows,)\",\"    _softmax_kernel[grid](\",\"        out,\",\"        x,\",\"        x.stride(0),\",\"        out.stride(0),\",\"        cols,\",\"        BLOCK_SIZE=BLOCK_SIZE,\",\"        num_warps=num_warps,\",\"    )\",\"    return out\"]}","request_id":"rewrite-r1","source_sha256":"4579b797ecefa15a3460a3b92124bca1f3d22483f7605d81426e9e89568225f1"},{"code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    out_ptr,\n    in_ptr,\n    in_row_stride,\n    out_row_stride,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    in_row = in_ptr + row * in_row_stride\n    out_row = out_ptr + row * out_row_stride\n    offs = tl.arange(0, BLOCK_SIZE)\n    mask = offs < n_cols\n    x = tl.load(in_row + offs, mask=mask, other=-float('inf')).to(tl.float32)\n    m = tl.max(x, axis=0)\n    e = tl.exp(x - m)\n    d = tl.sum(e, axis=0)\n    y = e / d\n    tl.store(out_row + offs, y, mask=mask)\n\n\ndef _next_pow2(n):\n    p = 1\n    while p < n:\n        p *= 2\n    return p\n\n\ndef _pick_warps(cols):\n    if cols <= 128:\n        return 1\n    if cols <= 512:\n        return 2\n    if cols <= 1024:\n        return 4\n    return 8\n\n\ndef run(x):\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = _next_pow2(cols)\n    num_warps = _pick_warps(cols)\n    grid = (rows,)\n    _softmax_kernel[grid](\n        out,\n        x,\n        x.stride(0),\n        out.stride(0),\n        cols,\n        BLOCK_SIZE=BLOCK_SIZE,\n        num_warps=num_warps,\n    )\n    return out\n","draft":"Single-row-per-CTA softmax. Tune num_warps by cols: 1 for <=128, 2 for <=512, 4 for <=1024, 8 for 2048. Keep FP32 math, masked load/store, fresh contiguous out.","evaluation":{"checks_passed":28,"cooperative_queue":{"lock_file":"
{"attempts":[{"code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    out_ptr,\n    in_ptr,\n    in_row_stride,\n    out_row_stride,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    in_row = in_ptr + row * in_row_stride\n    out_row = out_ptr + row * out_row_stride\n    offs = tl.arange(0, BLOCK_SIZE)\n    mask = offs < n_cols\n    x = tl.load(in_row + offs, mask=mask, other=-float('inf')).to(tl.float32)\n    m = tl.max(x, axis=0)\n    e = tl.exp(x - m)\n    d = tl.sum(e, axis=0)\n    y = e / d\n    tl.store(out_row + offs, y, mask=mask)\n\n\ndef _next_pow2(n):\n    p = 1\n    while p < n:\n        p *= 2\n    return p\n\n\ndef run(x):\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = _next_pow2(cols)\n    grid = (rows,)\n    _softmax_kernel[grid](\n        out,\n        x,\n        x.stride(0),\n        out.stride(0),\n        cols,\n        BLOCK_SIZE=BLOCK_SIZE,\n    )\n    return out\n","draft":"Row-parallel softmax. One program per row. Load row with mask, FP32 max/exp/sum, store masked. Grid rows. Constexpr block next pow2 cols.","evaluation":{"checks_passed":28,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-semantic-experiment-v1/gpu4.lock","pid":2588745,"scope":"serializes this project's workers only","wait_seconds":5.782395601272583e-05},"device_audit":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"device_binding":{"actual":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"child_visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50","expected_gpu_index":4,"expected_uuid":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50","verified":true},"gpu":"NVIDIA GeForce
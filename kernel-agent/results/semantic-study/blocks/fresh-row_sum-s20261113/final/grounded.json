{"attempts":[{"code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _row_sum_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n        acc += a\n    s = tl.sum(acc, axis=0)\n    tl.store(Y + row, s)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    rows, cols = x.shape\n    out = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    if rows == 0 or cols == 0:\n        return out\n    BLOCK_SIZE = 1024\n    grid = (rows,)\n    _row_sum_kernel[grid](x, out, cols, cols, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n","draft":"Row-sum kernel: one program per row, loop over columns in power-of-two blocks, mask odd widths, accumulate in FP32, store cast to input dtype.","evaluation":{"checks_passed":28,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-semantic-experiment-v1/gpu4.lock","pid":2590508,"scope":"serializes this project's workers only","wait_seconds":5.687400698661804e-05},"device_audit":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"device_binding":{"actual":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"child_visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50","expected_gpu_index":4,"expected_uuid":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50","verified":true},"gpu":"NVIDIA GeForce RTX 4090","measurement_condition":"shared_observed","resource_audit":{"after":{"free_mib":24199,"gpu_uuid":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50","observ
dtype=tl.float32)\",\"    for off in range(0, N, BLOCK_SIZE):\",\"        cols = off + tl.arange(0, BLOCK_SIZE)\",\"        mask = cols < N\",\"        a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\",\"        acc += a\",\"    s = tl.sum(acc, axis=0)\",\"    tl.store(Y + row, s)\",\"\",\"\",\"def run(x: torch.Tensor) -> torch.Tensor:\",\"    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\",\"    rows, cols = x.shape\",\"    out = torch.empty((rows,), dtype=x.dtype, device=x.device)\",\"    if rows == 0 or cols == 0:\",\"        return out\",\"    BLOCK_SIZE = 1024\",\"    grid = (rows,)\",\"    _row_sum_kernel[grid](x, out, cols, cols, BLOCK_SIZE=BLOCK_SIZE)\",\"    return out\"]}","request_id":"initial","source_sha256":"2be94d8ea2cec6881b4933111edd0fd2394e347855e58d4b3456e0e80be6c2d5"},{"code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _row_sum_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    cols = tl.arange(0, BLOCK_SIZE)\n    mask = cols < N\n    a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n    s = tl.sum(a, axis=0)\n    tl.store(Y + row, s)\n\n\ndef _next_pow2(n: int) -> int:\n    if n <= 1:\n        return 1\n    p = 1\n    while p < n:\n        p <<= 1\n    return p\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    rows, cols = x.shape\n    out = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    if rows == 0 or cols == 0:\n        return out\n    BLOCK_SIZE = min(_next_pow2(cols), 4096)\n    grid = (rows,)\n    _row_sum_kernel[grid](x, out, cols, cols, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n","draft":"Optimize small-row case: use a single block sized to the next power of two of cols (capped at 4096) so rows<=256 avoid the loop overhead that torch.compile exploits. Keep FP32 accumulation and a single cast at store.","evaluation":{"c
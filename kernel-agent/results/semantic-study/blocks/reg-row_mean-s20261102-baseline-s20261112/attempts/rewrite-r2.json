{"code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _row_mean_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    cols = tl.arange(0, BLOCK_SIZE)\n    mask = cols < N\n    a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n    total = tl.sum(a, axis=0)\n    mean = total / N\n    tl.store(Y + row, mean)\n\n\ndef run(x):\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, width = x.shape\n    out = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    if rows == 0 or width == 0:\n        return out\n    BLOCK_SIZE = triton.next_power_of_2(width)\n    grid = (rows,)\n    _row_mean_kernel[grid](x, out, width, width, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n","draft":"Single-pass row mean. Pick BLOCK=next_pow2(N) so one masked load covers the row; sum in FP32, divide by actual N, store scalar.","evaluation":{"checks_passed":28,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-semantic-experiment-v1/gpu4.lock","pid":2576809,"scope":"serializes this project's workers only","wait_seconds":5.0623743906617165},"device_audit":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"device_binding":{"actual":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"child_visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50","expected_gpu_index":4,"expected_uuid":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50","verified":true},"gpu":"NVIDIA GeForce RTX 4090","measurement_condition":"shared_observed","resource_audit":{"after":{"free_mib":24199,"gpu_uuid":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50","observed_utc":"2026-10-15T17:53:15.571159+00:00","pids":[],"power_watts":64.37,"sm_clock_mhz":2520,"used_mib":12,"utilizat
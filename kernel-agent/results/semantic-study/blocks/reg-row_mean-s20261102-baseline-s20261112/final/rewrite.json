{"attempts":[{"code":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _row_mean_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    Y += row * stride\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n        acc += a\n    total = tl.sum(acc, axis=0)\n    mean = total / N\n    tl.store(Y, mean)\n\n\ndef run(x):\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, width = x.shape\n    out = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    if rows == 0 or width == 0:\n        return out\n    BLOCK_SIZE = 1024\n    grid = (rows,)\n    _row_mean_kernel[grid](x, out, width, width, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n","draft":"Triton kernel sums each row in FP32 over actual width, divides by width, stores in input dtype. Host allocates contiguous output, launches one program per row, returns output.","evaluation":{"checks_passed":2,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-semantic-experiment-v1/gpu4.lock","pid":2574227,"scope":"serializes this project's workers only","wait_seconds":4.8201531171798706e-05},"device_audit":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"device_binding":{"actual":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"child_visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50","expected_gpu_index":4,"expected_uuid":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50","verified":true},"dtype":"torch.float32","measurement_condition":"shared_observed","message":"Tensor-likes are not close!\n\n
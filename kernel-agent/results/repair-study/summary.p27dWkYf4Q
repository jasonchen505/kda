              {
                "code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _rmsnorm_kernel(\n    X,\n    Y,\n    W,\n    stride,\n    N,\n    eps,\n    BLOCK_SIZE: tl.constexpr,\n    IS_BF16: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    Y += row * stride\n\n    cols = tl.arange(0, BLOCK_SIZE)\n    mask = cols < N\n    x = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n\n    sum_sq = tl.sum(x * x, axis=0)\n    mean_sq = sum_sq / N\n    rstd = 1.0 / tl.sqrt(mean_sq + eps)\n\n    x_hat = x * rstd\n    if IS_BF16:\n        x_hat = x_hat.to(tl.bfloat16)\n    else:\n        x_hat = x_hat.to(tl.float32)\n\n    w = tl.load(W + cols, mask=mask)\n    y = w * x_hat\n    tl.store(Y + cols, y, mask=mask)\n\n\ndef run(x, weight):\n    rows, width = x.shape\n    out = torch.empty_like(x)\n\n    BLOCK_SIZE = triton.next_power_of_2(width)\n    if BLOCK_SIZE > 4096:\n        BLOCK_SIZE = 4096\n\n    is_bf16 = 1 if x.dtype == torch.bfloat16 else 0\n\n    grid = (rows,)\n    _rmsnorm_kernel[grid](\n        x,\n        out,\n        weight,\n        width,\n        width,\n        1e-6,\n        BLOCK_SIZE=BLOCK_SIZE,\n        IS_BF16=is_bf16,\n    )\n    return out\n",
                "draft": "Fuse RMSNorm into one pass: load row once, accumulate sum-of-squares in FP32, compute rstd, then normalize, cast to input dtype, multiply by weight, and store. Use a single BLOCK_SIZE loop to avoid double memory traffic. Keep the intermediate cast before weight multiplication.",

                "request_id": "initial-contract",
                "source_sha256": "84b335eeaa940add2c015b3b3ed3da62434ecc6dbf022cf0bbe6714e89acaf27"
              },
              {
                "code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    output_ptr,\n    input_ptr,\n    input_row_stride,\n    output_row_stride,\n    n_rows,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n    NUM_STAGES: tl.constexpr,\n    NUM_PROGS: tl.constexpr,\n):\n    row_start = tl.program_id(0)\n    row_step = NUM_PROGS\n    for row_idx in tl.range(row_start, n_rows, row_step, num_stages=NUM_STAGES):\n        row_start_ptr = input_ptr + row_idx * input_row_stride\n        col_offsets = tl.arange(0, BLOCK_SIZE)\n        mask = col_offsets < n_cols\n        row = tl.load(row_start_ptr + col_offsets, mask=mask, other=-float('inf')).to(tl.float32)\n        row_max = tl.max(row, axis=0)\n        numerator = tl.exp(row - row_max)\n        denominator = tl.sum(numerator, axis=0)\n        softmax_output = numerator / denominator\n        output_row_start_ptr = output_ptr + row_idx * output_row_stride\n        tl.store(output_row_start_ptr + col_offsets, softmax_output, mask=mask)\n    return\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    output = torch.empty_like(x)\n    BLOCK_SIZE = triton.cdiv(n_cols, 1)\n    BLOCK_SIZE = 1 << (BLOCK_SIZE - 1).bit_length()\n    NUM_PROGS = min(n_rows, 256)\n    grid = (NUM_PROGS,)\n    _softmax_kernel[grid](\n        output,\n        x,\n        n_cols,\n        n_cols,\n        n_rows,\n        n_cols,\n        BLOCK_SIZE=BLOCK_SIZE,\n        NUM_STAGES=2,\n        NUM_PROGS=NUM_PROGS,\n    )\n    return output\n",
                "draft": "Hypothesis: the slowest shape [256,2048] is latency-bound by a single row per program. Observed contradiction: candidate is already faster than compiled on all search shapes, so preserve semantics and add a persistent loop to amortize launch/occupancy overhead. Coordinates: out[r,c]=in[r,c]; flat offset r*stride_in+c and r*stride_out+c. Edge [3,5]: r=2,c=4 -> in 2*5+4=14, out 2*5+4=14.",

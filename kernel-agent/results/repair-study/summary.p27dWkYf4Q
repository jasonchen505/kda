                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _mean_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    Y += row * stride\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n        acc += a\n    total = tl.sum(acc, axis=0)\n    mean = total / N\n    tl.store(Y, mean)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, width = x.shape\n    y = torch.empty_like(x, memory_format=torch.contiguous_format)[:, :0]\n    y = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    BLOCK_SIZE = 1024\n    grid = (rows,)\n    _mean_kernel[grid](x, y, width, width, BLOCK_SIZE=BLOCK_SIZE)\n    return y\n\n",
                "reply": "{\"draft\":\"Mean over last dim. Allocate output. Kernel sums masked FP32 values, divides by actual width, casts to input dtype. Grid rows. Handle odd widths via masks.\",\"plan\":\"Host: allocate contiguous output, compute grid, launch. Kernel: loop over width in BLOCK chunks, load masked, sum in FP32, divide by N, store cast.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _mean_kernel(\",\"    X,\",\"    Y,\",\"    stride,\",\"    N,\",\"    BLOCK_SIZE: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    X += row * stride\",\"    Y += row * stride\",\"    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\",\"    for off in range(0, N, BLOCK_SIZE):\",\"        cols = off + tl.arange(0, BLOCK_SIZE)\",\"        mask = cols < N\",\"        a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\",\"        acc += a\",\"    total = tl.sum(acc, axis=0)\",\"    mean = total / N\",\"    tl.store(Y, mean)\",\"\",\"\",\"def run(x: torch.Tensor) -> torch.Tensor:\",\"    assert x.is_cuda\",\"    assert x.dim() == 2\",\"    assert x.is_contiguous()\",\"    rows, width = x.shape\",\"    y = torch.empty_like(x, memory_format=torch.contiguous_format)[:, :0]\",\"    y = torch.empty((rows,), dtype=x.dtype, device=x.device)\",\"    BLOCK_SIZE = 1024\",\"    grid = (rows,)\",\"    _mean_kernel[grid](x, y, width, width, BLOCK_SIZE=BLOCK_SIZE)\",\"    return y\",\"\"]}",

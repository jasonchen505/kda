                "plan": "Fix the store offset to Y + row. Keep the 1D grid over rows, masked FP32 accumulation, and division by the actual width. Allocate a fresh contiguous output and return it.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _row_mean_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n        acc += a\n    total = tl.sum(acc, axis=0)\n    mean = total / N\n    tl.store(Y + row, mean)\n\n\ndef run(x):\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, width = x.shape\n    out = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    if rows == 0 or width == 0:\n        return out\n    BLOCK_SIZE = 1024\n    grid = (rows,)\n    _row_mean_kernel[grid](x, out, width, width, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n",

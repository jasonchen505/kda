                "parent_sha256": null,
                "plan": "Allocate contiguous output (rows,). Kernel: one program per row. Loop over columns in BLOCK_SIZE chunks. Load with mask cols < N, other=0.0. Accumulate in FP32. Store sum cast to output dtype. No division needed for sum.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _row_sum_kernel(\n    X,  # pointer to input\n    Y,  # pointer to output\n    stride_x,  # row stride of input\n    N,  # number of columns\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride_x\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        x = tl.load(X + cols, mask=mask, other=0.0).to(tl.float32)\n        acc += x\n    result = tl.sum(acc, axis=0)\n    Y += row\n    tl.store(Y, result)\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda, \"Input must be a CUDA tensor\"\n    assert x.dim() == 2, \"Input must be 2D\"\n    assert x.is_contiguous(), \"Input must be contiguous\"\n    rows, cols = x.shape\n    out = torch.empty(rows, dtype=x.dtype, device=x.device)\n    if rows == 0:\n        return out\n    BLOCK_SIZE = triton.next_power_of_2(cols)\n    grid = (rows,)\n    _row_sum_kernel[grid](x, out, x.stride(0), cols, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n",
                "reply": "{\n  \"draft\": \"Output shape (rows,), stride 1. Input stride (cols, 1). Row r maps to input offset r*cols. For r=0, c=0: offset 0. For r=1, c=cols-1: offset cols + (cols-1). Sum input row in FP32, cast to output dtype.\",\n  \"plan\": \"Allocate contiguous output (rows,). Kernel: one program per row. Loop over columns in BLOCK_SIZE chunks. Load with mask cols < N, other=0.0. Accumulate in FP32. Store sum cast to output dtype. No division needed for sum.\",\n  \"code_lines\": [\n    \"import torch\",\n    \"import triton\",\n    \"import triton.language as tl\",\n    \"\",\n    \"@triton.jit\",\n    \"def _row_sum_kernel(\",\n    \"    X,  # pointer to input\",\n    \"    Y,  # pointer to output\",\n    \"    stride_x,  # row stride of input\",\n    \"    N,  # number of columns\",\n    \"    BLOCK_SIZE: tl.constexpr,\",\n    \"):\",\n    \"    row = tl.program_id(0)\",\n    \"    X += row * stride_x\",\n    \"    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\",\n    \"    for off in range(0, N, BLOCK_SIZE):\",\n    \"        cols = off + tl.arange(0, BLOCK_SIZE)\",\n    \"        mask = cols < N\",\n    \"        x = tl.load(X + cols, mask=mask, other=0.0).to(tl.float32)\",\n    \"        acc += x\",\n    \"    result = tl.sum(acc, axis=0)\",\n    \"    Y += row\",\n    \"    tl.store(Y, result)\",\n    \"\",\n    \"def run(x: torch.Tensor) -> torch.Tensor:\",\n    \"    assert x.is_cuda, \\\"Input must be a CUDA tensor\\\"\",\n    \"    assert x.dim() == 2, \\\"Input must be 2D\\\"\",\n    \"    assert x.is_contiguous(), \\\"Input must be contiguous\\\"\",\n    \"    rows, cols = x.shape\",\n    \"    out = torch.empty(rows, dtype=x.dtype, device=x.device)\",\n    \"    if rows == 0:\",\n    \"        return out\",\n    \"    BLOCK_SIZE = triton.next_power_of_2(cols)\",\n    \"    grid = (rows,)\",\n    \"    _row_sum_kernel[grid](x, out, x.stride(0), cols, BLOCK_SIZE=BLOCK_SIZE)\",\n    \"    return out\"\n  ]\n}",

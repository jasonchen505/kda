          "g-contract_r-baseline": {
            "attempts": [
              {
                "code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _add_kernel(x_ptr, y_ptr, out_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n    pid = tl.program_id(axis=0)\n    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n    mask = offsets < n_elements\n    x = tl.load(x_ptr + offsets, mask=mask, other=0.0)\n    y = tl.load(y_ptr + offsets, mask=mask, other=0.0)\n    x_f32 = x.to(tl.float32)\n    y_f32 = y.to(tl.float32)\n    s = x_f32 + y_f32\n    out = s.to(x_ptr.dtype.element_ty)\n    tl.store(out_ptr + offsets, out, mask=mask)\n\n\ndef run(x: torch.Tensor, y: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and y.is_cuda\n    assert x.shape == y.shape\n    assert x.dtype in (torch.float32, torch.bfloat16)\n    assert x.dtype == y.dtype\n    assert x.is_contiguous() and y.is_contiguous()\n    out = torch.empty_like(x)\n    n = x.numel()\n    BLOCK_SIZE = 1024\n    grid = (triton.cdiv(n, BLOCK_SIZE),)\n    _add_kernel[grid](x, y, out, n, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n",
                "draft": "Output shape equals x.shape; contiguous strides are 1. Flat offset i maps to x[i], y[i], out[i]. For shape (3,5), coord (2,4) -> flat 14; x[14]+y[14]->out[14]. Edge (0,0)->0. Odd total 15 handled by mask. Inputs immutable; allocate fresh contiguous output.",

            "parent_sha256": null,
            "plan": "Allocate fresh contiguous output same dtype/shape. Load row masked with other=-inf. Compute max, exp, sum in FP32. Divide. Store masked. Cast output to input dtype via tl.store auto-cast. Grid=(R,). Use triton.cdiv for BLOCK_SIZE. No torch compute.",
            "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    output_ptr,\n    input_ptr,\n    input_row_stride,\n    output_row_stride,\n    n_rows,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row_idx = tl.program_id(0)\n    row_start_ptr = input_ptr + row_idx * input_row_stride\n    col_offsets = tl.arange(0, BLOCK_SIZE)\n    mask = col_offsets < n_cols\n    row = tl.load(row_start_ptr + col_offsets, mask=mask, other=-float('inf')).to(tl.float32)\n    row_max = tl.max(row, axis=0)\n    numerator = tl.exp(row - row_max)\n    denominator = tl.sum(numerator, axis=0)\n    softmax_output = numerator / denominator\n    output_row_start_ptr = output_ptr + row_idx * output_row_stride\n    tl.store(output_row_start_ptr + col_offsets, softmax_output, mask=mask)\n    return\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    output = torch.empty_like(x)\n    BLOCK_SIZE = triton.cdiv(n_cols, 1)\n    # next power of two\n    BLOCK_SIZE = 1 << (BLOCK_SIZE - 1).bit_length()\n    grid = (n_rows,)\n    _softmax_kernel[grid](\n        output,\n        x,\n        n_cols,\n        n_cols,\n        n_rows,\n        n_cols,\n        BLOCK_SIZE=BLOCK_SIZE,\n    )\n    return output\n",
            "reply": "{\"draft\":\"Output shape equals input (R,C), contiguous. Strides: input_row_stride=C, output_row_stride=C. For row r, col c: input offset r*C+c, output offset r*C+c. Check (0,0): 0; (R-1,C-1): (R-1)*C+C-1. Padded cols use -inf so exp=0, sum unaffected. BLOCK_SIZE=next_pow2(C).\",\"plan\":\"Allocate fresh contiguous output same dtype/shape. Load row masked with other=-inf. Compute max, exp, sum in FP32. Divide. Store masked. Cast output to input dtype via tl.store auto-cast. Grid=(R,). Use triton.cdiv for BLOCK_SIZE. No torch compute.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _softmax_kernel(\",\"    output_ptr,\",\"    input_ptr,\",\"    input_row_stride,\",\"    output_row_stride,\",\"    n_rows,\",\"    n_cols,\",\"    BLOCK_SIZE: tl.constexpr,\",\"):\",\"    row_idx = tl.program_id(0)\",\"    row_start_ptr = input_ptr + row_idx * input_row_stride\",\"    col_offsets = tl.arange(0, BLOCK_SIZE)\",\"    mask = col_offsets < n_cols\",\"    row = tl.load(row_start_ptr + col_offsets, mask=mask, other=-float('inf')).to(tl.float32)\",\"    row_max = tl.max(row, axis=0)\",\"    numerator = tl.exp(row - row_max)\",\"    denominator = tl.sum(numerator, axis=0)\",\"    softmax_output = numerator / denominator\",\"    output_row_start_ptr = output_ptr + row_idx * output_row_stride\",\"    tl.store(output_row_start_ptr + col_offsets, softmax_output, mask=mask)\",\"    return\",\"\",\"def run(x: torch.Tensor) -> torch.Tensor:\",\"    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\",\"    n_rows, n_cols = x.shape\",\"    output = torch.empty_like(x)\",\"    BLOCK_SIZE = triton.cdiv(n_cols, 1)\",\"    # next power of two\",\"    BLOCK_SIZE = 1 << (BLOCK_SIZE - 1).bit_length()\",\"    grid = (n_rows,)\",\"    _softmax_kernel[grid](\",\"        output,\",\"        x,\",\"        n_cols,\",\"        n_cols,\",\"        n_rows,\",\"        n_cols,\",\"        BLOCK_SIZE=BLOCK_SIZE,\",\"    )\",\"    return output\"]}",

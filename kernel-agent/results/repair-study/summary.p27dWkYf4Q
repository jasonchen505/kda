            "parent_sha256": null,
            "plan": "Use BLOCK_SIZE power-of-two >= width. Mask cols < width. Sum in float32. Divide by width. Cast to x.dtype. Store with mask. Grid (rows,). Pass tensors directly. Use triton.cdiv for grid if needed, but rows is small.",
            "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _mean_kernel(\n    X,\n    Y,\n    stride_x,\n    width,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride_x\n    Y += row\n    cols = tl.arange(0, BLOCK_SIZE)\n    mask = cols < width\n    x = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n    s = tl.sum(x, axis=0)\n    mean = s / width\n    y = mean.to(Y.dtype.element_ty)\n    tl.store(Y, y)\n\n\ndef run(x):\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, width = x.shape\n    out = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    BLOCK_SIZE = triton.next_power_of_2(width)\n    grid = (rows,)\n    _mean_kernel[grid](x, out, x.stride(0), width, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n",
            "reply": "{\"draft\":\"Output shape (rows,). Input stride 1. Output offset r. Input offset r*width+c. Check (0,0)->0 and (1,3)->7 for 2x4. Padded zeros neutral. Divide by actual width. Cast to float32 for sum, then back to input dtype. Allocate contiguous output.\",\"plan\":\"Use BLOCK_SIZE power-of-two >= width. Mask cols < width. Sum in float32. Divide by width. Cast to x.dtype. Store with mask. Grid (rows,). Pass tensors directly. Use triton.cdiv for grid if needed, but rows is small.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _mean_kernel(\",\"    X,\",\"    Y,\",\"    stride_x,\",\"    width,\",\"    BLOCK_SIZE: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    X += row * stride_x\",\"    Y += row\",\"    cols = tl.arange(0, BLOCK_SIZE)\",\"    mask = cols < width\",\"    x = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\",\"    s = tl.sum(x, axis=0)\",\"    mean = s / width\",\"    y = mean.to(Y.dtype.element_ty)\",\"    tl.store(Y, y)\",\"\",\"\",\"def run(x):\",\"    assert x.is_cuda\",\"    assert x.dim() == 2\",\"    assert x.is_contiguous()\",\"    rows, width = x.shape\",\"    out = torch.empty((rows,), dtype=x.dtype, device=x.device)\",\"    BLOCK_SIZE = triton.next_power_of_2(width)\",\"    grid = (rows,)\",\"    _mean_kernel[grid](x, out, x.stride(0), width, BLOCK_SIZE=BLOCK_SIZE)\",\"    return out\"]}",

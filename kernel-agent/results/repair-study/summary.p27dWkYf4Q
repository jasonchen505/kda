                "plan": "Allocate output (rows,). Launch grid (rows,). Kernel: pid=row, base=X+row*cols. For off in range(0,cols,BLOCK): load masked, to fp32, sum. Store scalar.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _row_sum_kernel(\n    X,\n    Y,\n    cols,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    base = X + row * cols\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, cols, BLOCK_SIZE):\n        cols_off = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols_off < cols\n        x = tl.load(base + cols_off, mask=mask, other=0.0).to(tl.float32)\n        acc += x\n    total = tl.sum(acc, axis=0)\n    tl.store(Y + row, total)\n    \n\ndef run(x):\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, cols = x.shape\n    out = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    BLOCK_SIZE = 1024\n    grid = (rows,)\n    _row_sum_kernel[grid](x, out, cols, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n",
                "reply": "{\"draft\":\"Row-wise sum kernel. One program per row. Loop over columns in power-of-two blocks, mask odd widths, accumulate in FP32, store cast to input dtype.\",\"plan\":\"Allocate output (rows,). Launch grid (rows,). Kernel: pid=row, base=X+row*cols. For off in range(0,cols,BLOCK): load masked, to fp32, sum. Store scalar.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _row_sum_kernel(\",\"    X,\",\"    Y,\",\"    cols,\",\"    BLOCK_SIZE: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    base = X + row * cols\",\"    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\",\"    for off in range(0, cols, BLOCK_SIZE):\",\"        cols_off = off + tl.arange(0, BLOCK_SIZE)\",\"        mask = cols_off < cols\",\"        x = tl.load(base + cols_off, mask=mask, other=0.0).to(tl.float32)\",\"        acc += x\",\"    total = tl.sum(acc, axis=0)\",\"    tl.store(Y + row, total)\",\"    \",\"\",\"def run(x):\",\"    assert x.is_cuda\",\"    assert x.dim() == 2\",\"    assert x.is_contiguous()\",\"    rows, cols = x.shape\",\"    out = torch.empty((rows,), dtype=x.dtype, device=x.device)\",\"    BLOCK_SIZE = 1024\",\"    grid = (rows,)\",\"    _row_sum_kernel[grid](x, out, cols, BLOCK_SIZE=BLOCK_SIZE)\",\"    return out\"]}",

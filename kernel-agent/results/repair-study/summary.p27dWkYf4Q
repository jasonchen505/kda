                "plan": "Allocate contiguous (rows,) output in input dtype. Kernel: one program per row, load width elements as fp32 with mask cols<N, other=0, sum, divide by N (actual width), store. BLOCK is constexpr power-of-two >= width. No loop. Preserves inputs, fresh output, correct odd sizes.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _mean_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    cols = tl.arange(0, BLOCK_SIZE)\n    mask = cols < N\n    a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n    total = tl.sum(a, axis=0)\n    mean = total / N\n    tl.store(Y + row, mean)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, width = x.shape\n    y = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    BLOCK_SIZE = 1\n    while BLOCK_SIZE < width:\n        BLOCK_SIZE *= 2\n    grid = (rows,)\n    _mean_kernel[grid](x, y, width, width, BLOCK_SIZE=BLOCK_SIZE)\n    return y\n",
                "reply": "{\"draft\":\"Hypothesis: the slowest shape [7,257] bf16 is launch/loop-bound; a single 1024-wide block with a 1-iteration loop adds overhead vs torch.compile. Contradiction: candidate 1.065us > compiled 1.039us. Fix: use a single vectorized load sized to the next power of two >= width (max 4096), no loop, divide by actual N. Verify: row0 col0 offset 0; row1 col256 offset 257+256=513; masked col257 excluded.\",\"plan\":\"Allocate contiguous (rows,) output in input dtype. Kernel: one program per row, load width elements as fp32 with mask cols<N, other=0, sum, divide by N (actual width), store. BLOCK is constexpr power-of-two >= width. No loop. Preserves inputs, fresh output, correct odd sizes.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _mean_kernel(\",\"    X,\",\"    Y,\",\"    stride,\",\"    N,\",\"    BLOCK_SIZE: tl.constexpr,\",\"):\", \"    row = tl.program_id(0)\",\"    X += row * stride\",\"    cols = tl.arange(0, BLOCK_SIZE)\",\"    mask = cols < N\",\"    a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\",\"    total = tl.sum(a, axis=0)\",\"    mean = total / N\",\"    tl.store(Y + row, mean)\",\"\",\"\",\"def run(x: torch.Tensor) -> torch.Tensor:\",\"    assert x.is_cuda\",\"    assert x.dim() == 2\",\"    assert x.is_contiguous()\",\"    rows, width = x.shape\",\"    y = torch.empty((rows,), dtype=x.dtype, device=x.device)\",\"    BLOCK_SIZE = 1\",\"    while BLOCK_SIZE < width:\",\"        BLOCK_SIZE *= 2\",\"    grid = (rows,)\",\"    _mean_kernel[grid](x, y, width, width, BLOCK_SIZE=BLOCK_SIZE)\",\"    return y\"]}",

                "plan": "Allocate fresh contiguous out. Read x via pointer, never write. Mask cols < width. Sum x^2 in FP32, divide by width. Cast normalized to BF16/FP32. Multiply by w. Store to out. Grid = rows. No input writes.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _rmsnorm_kernel(\n    X,\n    W,\n    Y,\n    stride_x,\n    stride_y,\n    width,\n    eps,\n    BLOCK: tl.constexpr,\n    IS_BF16: tl.constexpr,\n):\n    row = tl.program_id(0)\n    x_ptr = X + row * stride_x\n    y_ptr = Y + row * stride_y\n    cols = tl.arange(0, BLOCK)\n    mask = cols < width\n    x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\n    x2 = x * x\n    sum_x2 = tl.sum(x2, axis=0)\n    mean_x2 = sum_x2 / width\n    rstd = tl.rsqrt(mean_x2 + eps)\n    normalized = x * rstd\n    if IS_BF16:\n        normalized = normalized.to(tl.bfloat16)\n    else:\n        normalized = normalized.to(tl.float32)\n    w = tl.load(W + cols, mask=mask, other=0.0)\n    y = w * normalized\n    tl.store(y_ptr + cols, y, mask=mask)\n\n\ndef run(x, weight):\n    rows, width = x.shape\n    out = torch.empty_like(x)\n    BLOCK = triton.next_power_of_2(width)\n    is_bf16 = x.dtype == torch.bfloat16\n    grid = (rows,)\n    _rmsnorm_kernel[grid](\n        x,\n        weight,\n        out,\n        width,\n        width,\n        width,\n        1e-6,\n        BLOCK=BLOCK,\n        IS_BF16=is_bf16,\n    )\n    return out\n",

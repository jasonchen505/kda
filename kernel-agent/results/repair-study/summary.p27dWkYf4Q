              },
              {
                "code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _mean_kernel(\n    X,\n    Y,\n    stride_x,\n    width,\n    BLOCK_SIZE: tl.constexpr,\n    N_CHUNKS: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride_x\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for i in tl.static_range(N_CHUNKS):\n        cols = i * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n        mask = cols < width\n        x = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n        acc += x\n    s = tl.sum(acc, axis=0)\n    mean = s / width\n    tl.store(Y + row, mean.to(Y.dtype.element_ty))\n\n\ndef run(x):\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, width = x.shape\n    out = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    BLOCK = 1024\n    n_chunks = triton.cdiv(width, BLOCK)\n    grid = (rows,)\n    _mean_kernel[grid](x, out, x.stride(0), width, BLOCK_SIZE=BLOCK, N_CHUNKS=n_chunks)\n    return out\n",
                "draft": "Fuse mean into one kernel per row. Use a fixed 1024-wide block and a Python-selected loop count so the compiler specializes per width. Accumulate in FP32, divide by actual width, and store directly in the input dtype. This removes the atomic path and the separate divide/cast kernel.",
                "evaluation": {

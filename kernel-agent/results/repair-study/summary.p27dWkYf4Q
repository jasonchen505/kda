                "parent_sha256": "fca6a0a22138cd2c664884e5145665137c586c33fcdadb38f014900b12436636",
                "plan": "Keep one program per row. Load in 1024-element chunks with masking. Sum in FP32, divide by width, store scalar. Allocate fresh contiguous output. No PyTorch compute.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _mean_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n    NUM_BLOCKS: tl.constexpr,\n    IS_BF16: tl.constexpr,\n    IS_F32: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        a = tl.load(X + cols, mask=mask, other=0.0).to(tl.float32)\n        acc += a\n    mean = tl.sum(acc, axis=0) / N\n    if IS_BF16:\n        out = mean.to(tl.bfloat16)\n    else:\n        out = mean.to(tl.float32)\n    tl.store(Y + row, out)\n\n\ndef run(x):\n    rows, width = x.shape\n    out = torch.empty(rows, dtype=x.dtype, device=x.device)\n    BLOCK_SIZE = 1024\n    NUM_BLOCKS = triton.cdiv(width, BLOCK_SIZE)\n    is_bf16 = x.dtype == torch.bfloat16\n    is_f32 = x.dtype == torch.float32\n    grid = (rows,)\n    _mean_kernel[grid](x, out, width, width, BLOCK_SIZE=BLOCK_SIZE, NUM_BLOCKS=NUM_BLOCKS, IS_BF16=is_bf16, IS_F32=is_f32)\n    return out\n",
                "reply": "{\"draft\":\"Single-pass row mean. Use a fixed 1024-wide block with a loop to cut launch overhead on tiny shapes while keeping large shapes fast. Accumulate in FP32, divide by actual width, store in input dtype.\",\"plan\":\"Keep one program per row. Load in 1024-element chunks with masking. Sum in FP32, divide by width, store scalar. Allocate fresh contiguous output. No PyTorch compute.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _mean_kernel(\",\"    X,\",\"    Y,\",\"    stride,\",\"    N,\",\"    BLOCK_SIZE: tl.constexpr,\",\"    NUM_BLOCKS: tl.constexpr,\",\"    IS_BF16: tl.constexpr,\",\"    IS_F32: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    X += row * stride\",\"    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\",\"    for off in range(0, N, BLOCK_SIZE):\",\"        cols = off + tl.arange(0, BLOCK_SIZE)\",\"        mask = cols < N\",\"        a = tl.load(X + cols, mask=mask, other=0.0).to(tl.float32)\",\"        acc += a\",\"    mean = tl.sum(acc, axis=0) / N\",\"    if IS_BF16:\",\"        out = mean.to(tl.bfloat16)\",\"    else:\",\"        out = mean.to(tl.float32)\",\"    tl.store(Y + row, out)\",\"\",\"\",\"def run(x):\",\"    rows, width = x.shape\",\"    out = torch.empty(rows, dtype=x.dtype, device=x.device)\",\"    BLOCK_SIZE = 1024\",\"    NUM_BLOCKS = triton.cdiv(width, BLOCK_SIZE)\",\"    is_bf16 = x.dtype == torch.bfloat16\",\"    is_f32 = x.dtype == torch.float32\",\"    grid = (rows,)\",\"    _mean_kernel[grid](x, out, width, width, BLOCK_SIZE=BLOCK_SIZE, NUM_BLOCKS=NUM_BLOCKS, IS_BF16=is_bf16, IS_F32=is_f32)\",\"    return out\"]}",
                "request_id": "contract-baseline-r1",
                "source_sha256": "dabbf7a7d131919f224713369111f47e3dc51a104e4157f2e0640e34d90a24b0"
              },
              {
                "code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _partial_sum_kernel(\n    X,\n    P,\n    stride_x,\n    stride_p,\n    N,\n    CHUNK,\n    SPLIT: tl.constexpr,\n    BLOCK_SIZE: tl.constexpr,\n    IS_BF16: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    chunk_id = pid % SPLIT\n    start = chunk_id * CHUNK\n    end = tl.minimum(start + CHUNK, N)\n    X += row * stride_x\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(start, end, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < end\n        a = tl.load(X + cols, mask=mask, other=0.0).to(tl.float32)\n        acc += a\n    s = tl.sum(acc, axis=0)\n    P += row * stride_p + chunk_id\n    tl.store(P, s)\n\n\n@triton.jit\ndef _reduce_kernel(\n    P,\n    Y,\n    stride_p,\n    N,\n    SPLIT: tl.constexpr,\n    IS_BF16: tl.constexpr,\n):\n    row = tl.program_id(0)\n    P += row * stride_p\n    offs = tl.arange(0, SPLIT)\n    mask = offs < SPLIT\n    partials = tl.load(P + offs, mask=mask, other=0.0)\n    total = tl.sum(partials, axis=0)\n    mean = total / N\n    if IS_BF16:\n        out = mean.to(tl.bfloat16)\n    else:\n        out = mean.to(tl.float32)\n    tl.store(Y + row, out)\n\n\ndef run(x):\n    rows, width = x.shape\n    out = torch.empty(rows, dtype=x.dtype, device=x.device)\n    is_bf16 = x.dtype == torch.bfloat16\n    SPLIT = max(1, min(8, triton.cdiv(width, 256)))\n    CHUNK = triton.cdiv(width, SPLIT)\n    BLOCK_SIZE = 256\n    partials = torch.empty(rows, SPLIT, dtype=torch.float32, device=x.device)\n    grid1 = (rows * SPLIT,)\n    _partial_sum_kernel[grid1](x, partials, width, SPLIT, width, CHUNK, SPLIT=SPLIT, BLOCK_SIZE=BLOCK_SIZE, IS_BF16=is_bf16)\n    grid2 = (rows,)\n    _reduce_kernel[grid2](partials, out, SPLIT, width, SPLIT=SPLIT, IS_BF16=is_bf16)\n    return out\n",
                "draft": "Split each row into multiple programs to parallelize small-width rows. Each program sums a contiguous chunk in FP32, writes partial to a scratch buffer, then a second kernel reduces partials per row. This targets the worst case [7,257] where single-program-per-row underutilizes SMs.",

                "parent_sha256": null,
                "plan": "Loop W in BLOCK chunks. Mask cols<W; other=0 for loads. mean=sum(x)/W; var=sum((x-mean)^2)/W; rstd=rsqrt(var+1e-5). Load w,b masked. y=(x-mean)*rstd*w+b. Store y masked, cast to x dtype. Allocate fresh contiguous out. Grid=(R,).",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _layer_norm_kernel(\n    X,\n    Y,\n    W,\n    B,\n    stride_x,\n    stride_y,\n    N,\n    eps,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    x_ptr = X + row * stride_x\n    y_ptr = Y + row * stride_y\n    mean = 0.0\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\n        mean += tl.sum(x, axis=0)\n    mean = mean / N\n    var = 0.0\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\n        x = tl.where(mask, x - mean, 0.0)\n        var += tl.sum(x * x, axis=0)\n    var = var / N\n    rstd = 1.0 / tl.sqrt(var + eps)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\n        w = tl.load(W + cols, mask=mask, other=0.0).to(tl.float32)\n        b = tl.load(B + cols, mask=mask, other=0.0).to(tl.float32)\n        y = (x - mean) * rstd * w + b\n        tl.store(y_ptr + cols, y, mask=mask)\n    \n\ndef run(x, weight, bias):\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    assert weight.is_cuda and weight.dim() == 1 and weight.is_contiguous()\n    assert bias.is_cuda and bias.dim() == 1 and bias.is_contiguous()\n    R, W = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(W)\n    grid = (R,)\n    _layer_norm_kernel[grid](\n        x, out, weight, bias,\n        x.stride(0), out.stride(0),\n        W, 1e-5,\n        BLOCK_SIZE=BLOCK_SIZE,\n    )\n    return out\n",
                "reply": "{\"draft\":\"Output shape (R,W) contiguous, stride_x=W, stride_y=W. Row r, col c: y[r,c]=((x[r,c]-mean_r)*rstd_r*w[c]+b[c]).to(dtype). Offsets: x_ptr=r*W+c, y_ptr=r*W+c, w_ptr=c, b_ptr=c. Check R=3,W=5: (0,0)->x[0],y[0]; (2,4)->x[14],y[14].\",\"plan\":\"Loop W in BLOCK chunks. Mask cols<W; other=0 for loads. mean=sum(x)/W; var=sum((x-mean)^2)/W; rstd=rsqrt(var+1e-5). Load w,b masked. y=(x-mean)*rstd*w+b. Store y masked, cast to x dtype. Allocate fresh contiguous out. Grid=(R,).\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"@triton.jit\",\"def _layer_norm_kernel(\",\"    X,\",\"    Y,\",\"    W,\",\"    B,\",\"    stride_x,\",\"    stride_y,\",\"    N,\",\"    eps,\",\"    BLOCK_SIZE: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    x_ptr = X + row * stride_x\",\"    y_ptr = Y + row * stride_y\",\"    mean = 0.0\",\"    for off in range(0, N, BLOCK_SIZE):\",\"        cols = off + tl.arange(0, BLOCK_SIZE)\",\"        mask = cols < N\",\"        x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\",\"        mean += tl.sum(x, axis=0)\",\"    mean = mean / N\",\"    var = 0.0\",\"    for off in range(0, N, BLOCK_SIZE):\",\"        cols = off + tl.arange(0, BLOCK_SIZE)\",\"        mask = cols < N\",\"        x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\",\"        x = tl.where(mask, x - mean, 0.0)\",\"        var += tl.sum(x * x, axis=0)\",\"    var = var / N\",\"    rstd = 1.0 / tl.sqrt(var + eps)\",\"    for off in range(0, N, BLOCK_SIZE):\",\"        cols = off + tl.arange(0, BLOCK_SIZE)\",\"        mask = cols < N\",\"        x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\",\"        w = tl.load(W + cols, mask=mask, other=0.0).to(tl.float32)\",\"        b = tl.load(B + cols, mask=mask, other=0.0).to(tl.float32)\",\"        y = (x - mean) * rstd * w + b\",\"        tl.store(y_ptr + cols, y, mask=mask)\",\"    \",\"\",\"def run(x, weight, bias):\",\"    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\",\"    assert weight.is_cuda and weight.dim() == 1 and weight.is_contiguous()\",\"    assert bias.is_cuda and bias.dim() == 1 and bias.is_contiguous()\",\"    R, W = x.shape\",\"    out = torch.empty_like(x)\",\"    BLOCK_SIZE = triton.next_power_of_2(W)\",\"    grid = (R,)\",\"    _layer_norm_kernel[grid](\",\"        x, out, weight, bias,\",\"        x.stride(0), out.stride(0),\",\"        W, 1e-5,\",\"        BLOCK_SIZE=BLOCK_SIZE,\",\"    )\",\"    return out\"]}",
                "request_id": "initial-contract",
                "source_sha256": "21f033fe8c24c221d714daf06cafd10760b4f16278c0fb772784e1f32789f0af"
              },
              {
                "code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _layer_norm_kernel(\n    X,\n    Y,\n    W,\n    B,\n    stride_x,\n    stride_y,\n    N,\n    eps,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    x_ptr = X + row * stride_x\n    y_ptr = Y + row * stride_y\n    sum_x = 0.0\n    sum_x2 = 0.0\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\n        sum_x += tl.sum(x, axis=0)\n        sum_x2 += tl.sum(x * x, axis=0)\n    mean = sum_x / N\n    var = sum_x2 / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\n        w = tl.load(W + cols, mask=mask, other=0.0).to(tl.float32)\n        b = tl.load(B + cols, mask=mask, other=0.0).to(tl.float32)\n        y = (x - mean) * rstd * w + b\n        tl.store(y_ptr + cols, y, mask=mask)\n\n\ndef run(x, weight, bias):\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    assert weight.is_cuda and weight.dim() == 1 and weight.is_contiguous()\n    assert bias.is_cuda and bias.dim() == 1 and bias.is_contiguous()\n    R, W = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(W)\n    grid = (R,)\n    _layer_norm_kernel[grid](\n        x, out, weight, bias,\n        x.stride(0), out.stride(0),\n        W, 1e-5,\n        BLOCK_SIZE=BLOCK_SIZE,\n    )\n    return out\n",
                "draft": "Fuse mean/var into one pass using Welford-style accumulation to cut memory traffic. Keep single-row grid, power-of-2 block, masked loads, FP32 math, final cast.",

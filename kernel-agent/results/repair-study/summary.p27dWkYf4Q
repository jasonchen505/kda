                "parent_sha256": "c142b1ed3ebdcdcab87e8fbb2bf578034eb22fa853c7f98faaa6870717b314d4",
                "plan": "Grid=(n_rows,). BLOCK=next_pow2(cols). Load row, max, exp, sum, divide, store. No persistent loop, no num_stages arg, minimal host logic.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    input_ptr,\n    output_ptr,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row_idx = tl.program_id(0)\n    col_offsets = tl.arange(0, BLOCK_SIZE)\n    mask = col_offsets < n_cols\n    row_ptrs = input_ptr + row_idx * n_cols + col_offsets\n    row = tl.load(row_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\n    row_max = tl.max(row, axis=0)\n    numerator = tl.exp(row - row_max)\n    denominator = tl.sum(numerator, axis=0)\n    result = numerator / denominator\n    out_ptrs = output_ptr + row_idx * n_cols + col_offsets\n    tl.store(out_ptrs, result, mask=mask)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(n_cols)\n    grid = (n_rows,)\n    _softmax_kernel[grid](x, out, n_cols, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n",
                "reply": "{\"draft\":\"One program per row; vectorized load, FP32 max/exp/sum, masked store. Avoid persistent loop and extra host work to cut launch overhead on small shapes.\",\"plan\":\"Grid=(n_rows,). BLOCK=next_pow2(cols). Load row, max, exp, sum, divide, store. No persistent loop, no num_stages arg, minimal host logic.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _softmax_kernel(\",\"    input_ptr,\",\"    output_ptr,\",\"    n_cols,\",\"    BLOCK_SIZE: tl.constexpr,\",\"):\",\"    row_idx = tl.program_id(0)\",\"    col_offsets = tl.arange(0, BLOCK_SIZE)\",\"    mask = col_offsets < n_cols\",\"    row_ptrs = input_ptr + row_idx * n_cols + col_offsets\",\"    row = tl.load(row_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\",\"    row_max = tl.max(row, axis=0)\",\"    numerator = tl.exp(row - row_max)\",\"    denominator = tl.sum(numerator, axis=0)\",\"    result = numerator / denominator\",\"    out_ptrs = output_ptr + row_idx * n_cols + col_offsets\",\"    tl.store(out_ptrs, result, mask=mask)\",\"\",\"\",\"def run(x: torch.Tensor) -> torch.Tensor:\",\"    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\",\"    n_rows, n_cols = x.shape\",\"    out = torch.empty_like(x)\",\"    BLOCK_SIZE = triton.next_power_of_2(n_cols)\",\"    grid = (n_rows,)\",\"    _softmax_kernel[grid](x, out, n_cols, BLOCK_SIZE=BLOCK_SIZE)\",\"    return out\"]}",
                "request_id": "baseline-baseline-r2",
                "source_sha256": "d2f9ad96de54b6e88fb96941aea3e74f8da2c2f541e8c2a134b97f5d2f08de19"

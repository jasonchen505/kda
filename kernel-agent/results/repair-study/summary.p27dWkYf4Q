                "parent_sha256": "297c3905a767b00c5516d65a34a976983cb104948e117ff2a37625cafeaf3a00",
                "plan": "Y is contiguous (rows,), stride 1. X row r offset r*width. Load masked cols<N, other=0, cast to fp32, sum, divide by actual N. Store scalar to Y+row. Allocate fresh contiguous output; inputs untouched. Odd N handled by mask.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _mean_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n        acc += a\n    total = tl.sum(acc, axis=0)\n    mean = total / N\n    tl.store(Y + row, mean)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, width = x.shape\n    y = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    BLOCK_SIZE = 1024\n    grid = (rows,)\n    _mean_kernel[grid](x, y, width, width, BLOCK_SIZE=BLOCK_SIZE)\n    return y\n",
                "reply": "{\"draft\":\"Hypothesis: output pointer was advanced by row*width, but Y is a flat (rows,) tensor, so row 1 wrote to offset 33 instead of 1. Witness: row 1 mean 1.6667 was stored at Y[33]; Y[1] kept row 0's 0.6667. Fix: store to Y+row only; keep X row offset row*width.\",\"plan\":\"Y is contiguous (rows,), stride 1. X row r offset r*width. Load masked cols<N, other=0, cast to fp32, sum, divide by actual N. Store scalar to Y+row. Allocate fresh contiguous output; inputs untouched. Odd N handled by mask.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _mean_kernel(\",\"    X,\",\"    Y,\",\"    stride,\",\"    N,\",\"    BLOCK_SIZE: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    X += row * stride\",\"    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\",\"    for off in range(0, N, BLOCK_SIZE):\",\"        cols = off + tl.arange(0, BLOCK_SIZE)\",\"        mask = cols < N\",\"        a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\",\"        acc += a\",\"    total = tl.sum(acc, axis=0)\",\"    mean = total / N\",\"    tl.store(Y + row, mean)\",\"\",\"\",\"def run(x: torch.Tensor) -> torch.Tensor:\",\"    assert x.is_cuda\",\"    assert x.dim() == 2\",\"    assert x.is_contiguous()\",\"    rows, width = x.shape\",\"    y = torch.empty((rows,), dtype=x.dtype, device=x.device)\",\"    BLOCK_SIZE = 1024\",\"    grid = (rows,)\",\"    _mean_kernel[grid](x, y, width, width, BLOCK_SIZE=BLOCK_SIZE)\",\"    return y\"]}",
                "request_id": "baseline-counterexample-r1",
                "source_sha256": "aa4c965435e843b1f33d342bef4996109448a7a32b5aef2373f833a434286bbb"
              },
              {
                "code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _mean_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    cols = tl.arange(0, BLOCK_SIZE)\n    mask = cols < N\n    a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n    total = tl.sum(a, axis=0)\n    mean = total / N\n    tl.store(Y + row, mean)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, width = x.shape\n    y = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    BLOCK_SIZE = 1\n    while BLOCK_SIZE < width:\n        BLOCK_SIZE *= 2\n    grid = (rows,)\n    _mean_kernel[grid](x, y, width, width, BLOCK_SIZE=BLOCK_SIZE)\n    return y\n",
                "draft": "Hypothesis: the slowest shape [7,257] bf16 is launch/loop-bound; a single 1024-wide block with a 1-iteration loop adds overhead vs torch.compile. Contradiction: candidate 1.065us > compiled 1.039us. Fix: use a single vectorized load sized to the next power of two >= width (max 4096), no loop, divide by actual N. Verify: row0 col0 offset 0; row1 col256 offset 257+256=513; masked col257 excluded.",

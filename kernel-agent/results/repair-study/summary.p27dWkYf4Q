          "g-contract_r-counterexample": {
            "attempts": [
              {
                "evaluation": {
                  "message": "reply must contain draft/plan strings and code_lines, one Python line per item",
                  "status": "protocol_error"
                },
                "parent_sha256": null,
                "reply": "{\"draft\":\"Output shape equals input (R,C), contiguous. In/out strides: (C,1). Coord (r,c) maps to flat r*C+c. Check R=3,C=5: (0,0)->0, (2,4)->14. BLOCK=next_pow2(C). Mask c<C. Load other=-inf. Cast to fp32, max, exp, sum, divide, cast to out dtype.\",\"plan\":\"Padded cols get -inf so exp=0, sum unaffected. Actual width C via mask. FP32 reductions. Cast input to fp32 before max/exp; cast result to out dtype on store. Allocate fresh contiguous output same shape/dtype. Grid over rows. Preserve input.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"@triton.jit\",\"def _softmax_kernel(\",\"    out_ptr, in_ptr,\",\"    in_row_stride, out_row_stride,\",\"    n_rows, n_cols,\",\"    BLOCK_SIZE: tl.constexpr,\",\"    IS_BF16: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    in_row = in_ptr + row * in_row_stride\",\"    out_row = out_ptr + row * out_row_stride\",\"    offs = tl.arange(0, BLOCK_SIZE)\",\"    mask = offs < n_cols\",\"    x = tl.load(in_row + offs, mask=mask, other=-float('inf'))\",\"    if IS_BF16:\",\"        x = x.to(tl.float32)\",\"    m = tl.max(x, axis=0)\",\"    e = tl.exp(x - m)\",\"    d = tl.sum(e, axis=0)\",\"    y = e / d\",\"    if IS_BF16:\",\"        y = y.to(tl.bfloat16)\",\"    tl.store(out_row + offs, y, mask=mask)\",\"\",\",\"    \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\
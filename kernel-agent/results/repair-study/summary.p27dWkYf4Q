                "parent_sha256": null,
                "plan": "Allocate contiguous output. Launch kernel with BLOCK_SIZE=next_pow2(cols). Use -inf mask. Cast to input dtype on store.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    input_ptr,\n    output_ptr,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row_idx = tl.program_id(0)\n    col_offsets = tl.arange(0, BLOCK_SIZE)\n    mask = col_offsets < n_cols\n    input_ptrs = input_ptr + row_idx * n_cols + col_offsets\n    row = tl.load(input_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\n    row_max = tl.max(row, axis=0)\n    numerator = tl.exp(row - row_max)\n    denominator = tl.sum(numerator, axis=0)\n    result = numerator / denominator\n    output_ptrs = output_ptr + row_idx * n_cols + col_offsets\n    tl.store(output_ptrs, result, mask=mask)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(n_cols)\n    grid = (n_rows,)\n    _softmax_kernel[grid](x, out, n_cols, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n",
                "reply": "{\"draft\":\"Row-parallel softmax. One program per row. Load row with mask, compute max/exp/sum in FP32, store masked. Grid (n_rows,).\",\"plan\":\"Allocate contiguous output. Launch kernel with BLOCK_SIZE=next_pow2(cols). Use -inf mask. Cast to input dtype on store.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _softmax_kernel(\",\"    input_ptr,\",\"    output_ptr,\",\"    n_cols,\",\"    BLOCK_SIZE: tl.constexpr,\",\"):\",\"    row_idx = tl.program_id(0)\",\"    col_offsets = tl.arange(0, BLOCK_SIZE)\",\"    mask = col_offsets < n_cols\",\"    input_ptrs = input_ptr + row_idx * n_cols + col_offsets\",\"    row = tl.load(input_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\",\"    row_max = tl.max(row, axis=0)\",\"    numerator = tl.exp(row - row_max)\",\"    denominator = tl.sum(numerator, axis=0)\",\"    result = numerator / denominator\",\"    output_ptrs = output_ptr + row_idx * n_cols + col_offsets\",\"    tl.store(output_ptrs, result, mask=mask)\",\"\",\"\",\"def run(x: torch.Tensor) -> torch.Tensor:\",\"    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\",\"    n_rows, n_cols = x.shape\",\"    out = torch.empty_like(x)\",\"    BLOCK_SIZE = triton.next_power_of_2(n_cols)\",\"    grid = (n_rows,)\",\"    _softmax_kernel[grid](x, out, n_cols, BLOCK_SIZE=BLOCK_SIZE)\",\"    return out\"]}",
                "request_id": "initial-baseline",
                "source_sha256": "a14ce78d72f39b02c7fe9f434e44b1dda9ea4928ebcfe9ab4e537dc908231990"
              },
              {
                "code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    input_ptr,\n    output_ptr,\n    n_rows,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n    num_stages: tl.constexpr,\n):\n    row_start = tl.program_id(0)\n    row_step = tl.num_programs(0)\n    for row_idx in tl.range(row_start, n_rows, row_step, num_stages=num_stages):\n        col_offsets = tl.arange(0, BLOCK_SIZE)\n        mask = col_offsets < n_cols\n        input_ptrs = input_ptr + row_idx * n_cols + col_offsets\n        row = tl.load(input_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\n        row_max = tl.max(row, axis=0)\n        numerator = tl.exp(row - row_max)\n        denominator = tl.sum(numerator, axis=0)\n        result = numerator / denominator\n        output_ptrs = output_ptr + row_idx * n_cols + col_offsets\n        tl.store(output_ptrs, result, mask=mask)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(n_cols)\n    grid = (min(n_rows, 1024),)\n    _softmax_kernel[grid](x, out, n_rows, n_cols, BLOCK_SIZE=BLOCK_SIZE, num_stages=2)\n    return out\n",
                "draft": "Hypothesis: single-block launch underutilizes SMs for small rows (e.g. 7x257), causing the ~1.26us floor. Contradiction: 128x1536 and 256x2048 are faster, but 7x257 is not. Fix: use a persistent grid-stride loop to increase parallelism for small row counts while preserving single-block-per-row semantics.",

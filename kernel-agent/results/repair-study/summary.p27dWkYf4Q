              {
                "draft": "Single-row kernel. Use exp2 with log2e scaling for speed. Tune warps by column count. Keep FP32 math and masked loads/stores for odd widths.",
                "evaluation": {
                  "message": "expected ':' (<unknown>, line 15)",
                  "status": "protocol_error"
                },
                "parent_sha256": "c91b768e6117d60ca5aadb811da91aca7a2c1a70f2dd703e41c40198421ad587",
                "plan": "Load row, max, exp2, sum, divide, store. Tune num_warps: 1 for small, 2 for mid, 4 for large. Use next_power_of_2 block. No loop needed since one row per program.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\nLOG2E = 1.4426950408889634\n\n\n@triton.jit\ndef _softmax_kernel(\n    input_ptr,\n    output_ptr,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n    IS_BF16: tl.constexpr,\n    LOG2E: tl.constexpr,\n),\n    row = tl.program_id(0)\n    col_offsets = tl.arange(0, BLOCK_SIZE)\n    mask = col_offsets < n_cols\n    in_ptrs = input_ptr + row * n_cols + col_offsets\n    row_vals = tl.load(in_ptrs, mask=mask, other=-float('inf'))\n    row_f32 = row_vals.to(tl.float32)\n    row_max = tl.max(row_f32, axis=0)\n    exp_vals = tl.exp2((row_f32 - row_max) * LOG2E)\n    denom = tl.sum(exp_vals, axis=0)\n    out_vals = exp_vals / denom\n    if IS_BF16:\n        out_vals = out_vals.to(tl.bfloat16)\n    out_ptrs = output_ptr + row * n_cols + col_offsets\n    tl.store(out_ptrs, out_vals, mask=mask)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(n_cols)\n    grid = (n_rows,)\n    if n_cols >= 1024:\n        num_warps = 4\n    elif n_cols >= 256:\n        num_warps = 2\n    else:\n        num_warps = 1\n    _softmax_kernel[grid](x, out, n_cols, BLOCK_SIZE=BLOCK_SIZE, IS_BF16=(x.dtype == torch.bfloat16), LOG2E=LOG2E, num_warps=num_warps)\n    return out\n",
                "reply": "{\"draft\":\"Single-row kernel. Use exp2 with log2e scaling for speed. Tune warps by column count. Keep FP32 math and masked loads/stores for odd widths.\",\"plan\":\"Load row, max, exp2, sum, divide, store. Tune num_warps: 1 for small, 2 for mid, 4 for large. Use next_power_of_2 block. No loop needed since one row per program.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"LOG2E = 1.4426950408889634\",\"\",\"\",\"@triton.jit\",\"def _softmax_kernel(\",\"    input_ptr,\",\"    output_ptr,\",\"    n_cols,\",\"    BLOCK_SIZE: tl.constexpr,\",\"    IS_BF16: tl.constexpr,\",\"    LOG2E: tl.constexpr,\",\"),\",\"    row = tl.program_id(0)\",\"    col_offsets = tl.arange(0, BLOCK_SIZE)\",\"    mask = col_offsets < n_cols\",\"    in_ptrs = input_ptr + row * n_cols + col_offsets\",\"    row_vals = tl.load(in_ptrs, mask=mask, other=-float('inf'))\",\"    row_f32 = row_vals.to(tl.float32)\",\"    row_max = tl.max(row_f32, axis=0)\",\"    exp_vals = tl.exp2((row_f32 - row_max) * LOG2E)\",\"    denom = tl.sum(exp_vals, axis=0)\",\"    out_vals = exp_vals / denom\",\"    if IS_BF16:\",\"        out_vals = out_vals.to(tl.bfloat16)\",\"    out_ptrs = output_ptr + row * n_cols + col_offsets\",\"    tl.store(out_ptrs, out_vals, mask=mask)\",\"\",\"\",\"def run(x: torch.Tensor) -> torch.Tensor:\",\"    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\",\"    n_rows, n_cols = x.shape\",\"    out = torch.empty_like(x)\",\"    BLOCK_SIZE = triton.next_power_of_2(n_cols)\",\"    grid = (n_rows,)\",\"    if n_cols >= 1024:\",\"        num_warps = 4\",\"    elif n_cols >= 256:\",\"        num_warps = 2\",\"    else:\",\"        num_warps = 1\",\"    _softmax_kernel[grid](x, out, n_cols, BLOCK_SIZE=BLOCK_SIZE, IS_BF16=(x.dtype == torch.bfloat16), LOG2E=LOG2E, num_warps=num_warps)\",\"    return out\"]}",

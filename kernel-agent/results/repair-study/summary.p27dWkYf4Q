                "code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _rmsnorm_kernel(\n    X,\n    W,\n    Y,\n    stride_x,\n    stride_y,\n    width,\n    eps,\n    BLOCK: tl.constexpr,\n    IS_BF16: tl.constexpr,\n):\n    row = tl.program_id(0)\n    x_ptr = X + row * stride_x\n    y_ptr = Y + row * stride_y\n    cols = tl.arange(0, BLOCK)\n    mask = cols < width\n    x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\n    x2 = x * x\n    sum_x2 = tl.sum(x2, axis=0)\n    mean_x2 = sum_x2 / width\n    rstd = tl.rsqrt(mean_x2 + eps)\n    normalized = x * rstd\n    if IS_BF16:\n        normalized = normalized.to(tl.bfloat16)\n    else:\n        normalized = normalized.to(tl.float32)\n    w = tl.load(W + cols, mask=mask, other=0.0)\n    y = w * normalized\n    tl.store(y_ptr + cols, y, mask=mask)\n\n\ndef run(x, weight):\n    rows, width = x.shape\n    out = torch.empty_like(x)\n    BLOCK = triton.next_power_of_2(width)\n    is_bf16 = x.dtype == torch.bfloat16\n    grid = (rows,)\n    _rmsnorm_kernel[grid](\n        x,\n        weight,\n        out,\n        width,\n        width,\n        width,\n        1e-6,\n        BLOCK=BLOCK,\n        IS_BF16=is_bf16,\n    )\n    return out\n",
                "draft": "Output shape (rows,width), contiguous. Row r, col c: out[r,c]=w[c]*((x[r,c].float()*rsqrt(mean(x[r,:].float()^2)+1e-6)).to(dtype)). Strides: x/out stride=width, w stride=1. Flat offsets: x=r*width+c, w=c, out=r*width+c. Check r=0,c=0 and r=1,c=width-1 for odd width=3: offsets 0,2 and 3,5.",

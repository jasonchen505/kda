                "parent_sha256": "fc55340fcc9cf916424e206742fe7bfd944f3e8567eccf00fd36b275050b2515",
                "plan": "Check [7,257]: row0 col0 off0, col256 off256<257 ok; row6 col256 off6*257+256. Padded lanes masked other=0. Sum FP32, divide by N=257. Cast to x.dtype on store. Allocate torch.empty(rows, dtype, device). Grid=(rows,). BLOCK constexpr power-of-two.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _mean_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n    SINGLE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    if SINGLE:\n        cols = tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        a = tl.load(X + cols, mask=mask, other=0.0).to(tl.float32)\n        acc += a\n    else:\n        for off in range(0, N, BLOCK_SIZE):\n            cols = off + tl.arange(0, BLOCK_SIZE)\n            mask = cols < N\n            a = tl.load(X + cols, mask=mask, other=0.0).to(tl.float32)\n            acc += a\n    mean = tl.sum(acc, axis=0) / N\n    tl.store(Y + row, mean)\n\n\ndef run(x):\n    rows, width = x.shape\n    out = torch.empty(rows, dtype=x.dtype, device=x.device)\n    BLOCK_SIZE = min(triton.next_power_of_2(width), 512)\n    SINGLE = width <= BLOCK_SIZE\n    grid = (rows,)\n    _mean_kernel[grid](x, out, width, width, BLOCK_SIZE=BLOCK_SIZE, SINGLE=SINGLE)\n    return out\n",
                "reply": "{\"draft\":\"Hypothesis: small odd shapes (e.g. [7,257]) are launch-latency bound; BLOCK=1024 wastes lanes. Contradiction: candidate 1.079us vs compiled 1.031us. Fix: pick BLOCK=next_pow2(width) capped at 512, single-pass when width<=512, keep FP32 sum / actual N, masked other=0, fresh contiguous out.\",\"plan\":\"Check [7,257]: row0 col0 off0, col256 off256<257 ok; row6 col256 off6*257+256. Padded lanes masked other=0. Sum FP32, divide by N=257. Cast to x.dtype on store. Allocate torch.empty(rows, dtype, device). Grid=(rows,). BLOCK constexpr power-of-two.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _mean_kernel(\",\"    X,\",\"    Y,\",\"    stride,\",\"    N,\",\"    BLOCK_SIZE: tl.constexpr,\",\"    SINGLE: tl.constexpr,\",\"):\", \"    row = tl.program_id(0)\",\"    X += row * stride\",\"    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\",\"    if SINGLE:\",\"        cols = tl.arange(0, BLOCK_SIZE)\",\"        mask = cols < N\",\"        a = tl.load(X + cols, mask=mask, other=0.0).to(tl.float32)\",\"        acc += a\",\"    else:\",\"        for off in range(0, N, BLOCK_SIZE):\",\"            cols = off + tl.arange(0, BLOCK_SIZE)\",\"            mask = cols < N\",\"            a = tl.load(X + cols, mask=mask, other=0.0).to(tl.float32)\",\"            acc += a\",\"    mean = tl.sum(acc, axis=0) / N\",\"    tl.store(Y + row, mean)\",\"\",\"\",\"def run(x):\",\"    rows, width = x.shape\",\"    out = torch.empty(rows, dtype=x.dtype, device=x.device)\",\"    BLOCK_SIZE = min(triton.next_power_of_2(width), 512)\",\"    SINGLE = width <= BLOCK_SIZE\",\"    grid = (rows,)\",\"    _mean_kernel[grid](x, out, width, width, BLOCK_SIZE=BLOCK_SIZE, SINGLE=SINGLE)\",\"    return out\"]}",
                "request_id": "contract-counterexample-r2",

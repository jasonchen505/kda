                "parent_sha256": "84b335eeaa940add2c015b3b3ed3da62434ecc6dbf022cf0bbe6714e89acaf27",
                "plan": "Keep one program per row. Use next power-of-two block. Load with mask, other=-inf. Compute max, exp, sum in FP32. Divide. Store with mask. Allocate fresh output.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    output_ptr,\n    input_ptr,\n    input_row_stride,\n    output_row_stride,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n    IS_BF16: tl.constexpr,\n    IS_FP32: tl.constexpr,\n):\n    row_idx = tl.program_id(0)\n    row_start_ptr = input_ptr + row_idx * input_row_stride\n    col_offsets = tl.arange(0, BLOCK_SIZE)\n    mask = col_offsets < n_cols\n    row = tl.load(row_start_ptr + col_offsets, mask=mask, other=-float('inf'))\n    if IS_BF16:\n        row = row.to(tl.float32)\n    elif IS_FP32:\n        row = row.to(tl.float32)\n    else:\n        row = row.to(tl.float32)\n    row_max = tl.max(row, axis=0)\n    numerator = tl.exp(row - row_max)\n    denominator = tl.sum(numerator, axis=0)\n    softmax_output = numerator / denominator\n    if IS_BF16:\n        softmax_output = softmax_output.to(tl.bfloat16)\n    elif IS_FP32:\n        softmax_output = softmax_output.to(tl.float32)\n    else:\n        softmax_output = softmax_output.to(tl.float32)\n    output_row_start_ptr = output_ptr + row_idx * output_row_stride\n    tl.store(output_row_start_ptr + col_offsets, softmax_output, mask=mask)\n    return\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    output = torch.empty_like(x)\n    BLOCK_SIZE = 1 << (n_cols - 1).bit_length()\n    grid = (n_rows,)\n    is_bf16 = x.dtype == torch.bfloat16\n    is_fp32 = x.dtype == torch.float32\n    _softmax_kernel[grid](\n        output,\n        x,\n        n_cols,\n        n_cols,\n        n_cols,\n        BLOCK_SIZE=BLOCK_SIZE,\n        IS_BF16=is_bf16,\n        IS_FP32=is_fp32,\n    )\n    return output\n",
                "reply": "{\"draft\":\"Single-pass row softmax. One program per row. Load row, subtract max, exp, sum, divide, store. Use next power-of-two block. Cast to FP32 for math, store back to original dtype.\",\"plan\":\"Keep one program per row. Use next power-of-two block. Load with mask, other=-inf. Compute max, exp, sum in FP32. Divide. Store with mask. Allocate fresh output.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _softmax_kernel(\",\"    output_ptr,\",\"    input_ptr,\",\"    input_row_stride,\",\"    output_row_stride,\",\"    n_cols,\",\"    BLOCK_SIZE: tl.constexpr,\",\"    IS_BF16: tl.constexpr,\",\"    IS_FP32: tl.constexpr,\",\"):\",\"    row_idx = tl.program_id(0)\",\"    row_start_ptr = input_ptr + row_idx * input_row_stride\",\"    col_offsets = tl.arange(0, BLOCK_SIZE)\",\"    mask = col_offsets < n_cols\",\"    row = tl.load(row_start_ptr + col_offsets, mask=mask, other=-float('inf'))\",\"    if IS_BF16:\",\"        row = row.to(tl.float32)\",\"    elif IS_FP32:\",\"        row = row.to(tl.float32)\",\"    else:\",\"        row = row.to(tl.float32)\",\"    row_max = tl.max(row, axis=0)\",\"    numerator = tl.exp(row - row_max)\",\"    denominator = tl.sum(numerator, axis=0)\",\"    softmax_output = numerator / denominator\",\"    if IS_BF16:\",\"        softmax_output = softmax_output.to(tl.bfloat16)\",\"    elif IS_FP32:\",\"        softmax_output = softmax_output.to(tl.float32)\",\"    else:\",\"        softmax_output = softmax_output.to(tl.float32)\",\"    output_row_start_ptr = output_ptr + row_idx * output_row_stride\",\"    tl.store(output_row_start_ptr + col_offsets, softmax_output, mask=mask)\",\"    return\",\"\",\"\",\"def run(x: torch.Tensor) -> torch.Tensor:\",\"    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\",\"    n_rows, n_cols = x.shape\",\"    output = torch.empty_like(x)\",\"    BLOCK_SIZE = 1 << (n_cols - 1).bit_length()\",\"    grid = (n_rows,)\",\"    is_bf16 = x.dtype == torch.bfloat16\",\"    is_fp32 = x.dtype == torch.float32\",\"    _softmax_kernel[grid](\",\"        output,\",\"        x,\",\"        n_cols,\",\"        n_cols,\",\"        n_cols,\",\"        BLOCK_SIZE=BLOCK_SIZE,\",\"        IS_BF16=is_bf16,\",\"        IS_FP32=is_fp32,\",\"    )\",\"    return output\"]}",
                "request_id": "contract-baseline-r1",
                "source_sha256": "f0a072780f2c6fba05cfdc900929b2155e5bb044af6782e737ad625d287d27cc"
              },
              {
                "code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    output_ptr,\n    input_ptr,\n    input_row_stride,\n    output_row_stride,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n    IS_BF16: tl.constexpr,\n    IS_FP32: tl.constexpr,\n):\n    row_idx = tl.program_id(0)\n    row_start_ptr = input_ptr + row_idx * input_row_stride\n    col_offsets = tl.arange(0, BLOCK_SIZE)\n    mask = col_offsets < n_cols\n    row = tl.load(row_start_ptr + col_offsets, mask=mask, other=-float('inf'))\n    if IS_BF16:\n        row = row.to(tl.float32)\n    elif IS_FP32:\n        row = row.to(tl.float32)\n    else:\n        row = row.to(tl.float32)\n    row_max = tl.max(row, axis=0)\n    numerator = tl.exp(row - row_max)\n    denominator = tl.sum(numerator, axis=0)\n    softmax_output = numerator / denominator\n    if IS_BF16:\n        softmax_output = softmax_output.to(tl.bfloat16)\n    elif IS_FP32:\n        softmax_output = softmax_output.to(tl.float32)\n    else:\n        softmax_output = softmax_output.to(tl.float32)\n    output_row_start_ptr = output_ptr + row_idx * output_row_stride\n    tl.store(output_row_start_ptr + col_offsets, softmax_output, mask=mask)\n    return\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    output = torch.empty_like(x)\n    BLOCK_SIZE = 1 << (n_cols - 1).bit_length()\n    grid = (n_rows,)\n    is_bf16 = x.dtype == torch.bfloat16\n    is_fp32 = x.dtype == torch.float32\n    _softmax_kernel[grid](\n        output,\n        x,\n        n_cols,\n        n_cols,\n        n_cols,\n        BLOCK_SIZE=BLOCK_SIZE,\n        IS_BF16=is_bf16,\n        IS_FP32=is_fp32,\n    )\n    return output\n",
                "draft": "Single-row-per-CTA softmax. Load row in FP32, subtract max, exp, sum, divide. Masked lanes use -inf. Store in input dtype. One program per row; no loop.",
                "duplicate_of": "contract-baseline-r1",

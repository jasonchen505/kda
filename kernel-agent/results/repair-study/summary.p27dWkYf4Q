                "parent_sha256": "1ee360a004402730e5e34b71974b072d54f0fb1ad93ddabe42e296922385f645",
                "plan": "Output shape equals input (R,C), contiguous row-major: out[r,c] at r*C+c; in[r,c] at r*C+c. Check (0,0)->0 and (0,C-1)->C-1. Padded lanes use -inf so max/sum ignore them; mask cols<C on load/store. Cast to FP32 before max/exp/sum; store casts back to x.dtype. Allocate fresh contiguous out via empty_like.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    out_ptr,\n    in_ptr,\n    n_rows,\n    n_cols,\n    in_row_stride,\n    out_row_stride,\n    BLOCK_SIZE: tl.constexpr,\n    NUM_WARPS: tl.constexpr,\n):\n    row = tl.program_id(0)\n    cols = tl.arange(0, BLOCK_SIZE)\n    mask = cols < n_cols\n    in_ptrs = in_ptr + row * in_row_stride + cols\n    x = tl.load(in_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\n    x_max = tl.max(x, axis=0)\n    e = tl.exp(x - x_max)\n    denom = tl.sum(e, axis=0)\n    y = e / denom\n    out_ptrs = out_ptr + row * out_row_stride + cols\n    tl.store(out_ptrs, y, mask=mask)\n    return\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(n_cols)\n    # Choose warps: small rows use fewer warps to cut launch/sync overhead\n    if BLOCK_SIZE <= 256:\n        num_warps = 1\n    elif BLOCK_SIZE <= 1024:\n        num_warps = 2\n    else:\n        num_warps = 4\n    grid = (n_rows,)\n    _softmax_kernel[grid](\n        out,\n        x,\n        n_rows,\n        n_cols,\n        x.stride(0),\n        out.stride(0),\n        BLOCK_SIZE=BLOCK_SIZE,\n        NUM_WARPS=num_warps,\n        num_warps=num_warps,\n    )\n    return out\n",
                "reply": "{\"draft\":\"Search passed; no correctness failure. Hypothesis: small-row shapes are launch-bound, so the geometric mean is capped near 1.0. Observed contradiction: [7,257] is only ~1.02x faster while large shapes are ~1.5x. Fix: keep exact semantics but reduce launch overhead by using a persistent grid (one program per row, no loop) and explicit num_warps for small rows.\",\"plan\":\"Output shape equals input (R,C), contiguous row-major: out[r,c] at r*C+c; in[r,c] at r*C+c. Check (0,0)->0 and (0,C-1)->C-1. Padded lanes use -inf so max/sum ignore them; mask cols<C on load/store. Cast to FP32 before max/exp/sum; store casts back to x.dtype. Allocate fresh contiguous out via empty_like.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _softmax_kernel(\",\"    out_ptr,\",\"    in_ptr,\",\"    n_rows,\",\"    n_cols,\",\"    in_row_stride,\",\"    out_row_stride,\",\"    BLOCK_SIZE: tl.constexpr,\",\"    NUM_WARPS: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    cols = tl.arange(0, BLOCK_SIZE)\",\"    mask = cols < n_cols\",\"    in_ptrs = in_ptr + row * in_row_stride + cols\",\"    x = tl.load(in_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\",\"    x_max = tl.max(x, axis=0)\",\"    e = tl.exp(x - x_max)\",\"    denom = tl.sum(e, axis=0)\",\"    y = e / denom\",\"    out_ptrs = out_ptr + row * out_row_stride + cols\",\"    tl.store(out_ptrs, y, mask=mask)\",\"    return\",\"\",\"def run(x: torch.Tensor) -> torch.Tensor:\",\"    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\",\"    n_rows, n_cols = x.shape\",\"    out = torch.empty_like(x)\",\"    BLOCK_SIZE = triton.next_power_of_2(n_cols)\",\"    # Choose warps: small rows use fewer warps to cut launch/sync overhead\",\"    if BLOCK_SIZE <= 256:\",\"        num_warps = 1\",\"    elif BLOCK_SIZE <= 1024:\",\"        num_warps = 2\",\"    else:\",\"        num_warps = 4\",\"    grid = (n_rows,)\",\"    _softmax_kernel[grid](\",\"        out,\",\"        x,\",\"        n_rows,\",\"        n_cols,\",\"        x.stride(0),\",\"        out.stride(0),\",\"        BLOCK_SIZE=BLOCK_SIZE,\",\"        NUM_WARPS=num_warps,\",\"        num_warps=num_warps,\",\"    )\",\"    return out\"]}",
                "request_id": "contract-counterexample-r2",

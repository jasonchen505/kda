                "parent_sha256": "c81eb27b4de6d3cb1714496361fcac1e2cc8d94e5f490ef50447f25a3e8372b4",
                "plan": "Host: allocate contiguous (rows,) output, choose BLOCK_SIZE=next_pow2(min(width,2048)), launch one program per row. Kernel: loop masked loads, sum in fp32, divide by width, cast to output dtype, store scalar.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _mean_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n    OUT_DTYPE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n        acc += a\n    total = tl.sum(acc, axis=0)\n    mean = total / N\n    tl.store(Y + row, mean.to(OUT_DTYPE))\n\n\ndef _next_pow2(n: int) -> int:\n    p = 1\n    while p < n:\n        p <<= 1\n    return p\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, width = x.shape\n    y = torch.empty((rows,), dtype=x.dtype, device=x.device)\n    BLOCK_SIZE = _next_pow2(min(width, 2048))\n    grid = (rows,)\n    out_dtype = tl.float32 if x.dtype == torch.float32 else tl.bfloat16\n    _mean_kernel[grid](x, y, width, width, BLOCK_SIZE=BLOCK_SIZE, OUT_DTYPE=out_dtype)\n    return y\n",
                "reply": "{\"draft\":\"Fuse row-mean into one kernel. Pick block size from width to cut loop iterations. Use fp32 accumulation, divide by true width, store in input dtype.\",\"plan\":\"Host: allocate contiguous (rows,) output, choose BLOCK_SIZE=next_pow2(min(width,2048)), launch one program per row. Kernel: loop masked loads, sum in fp32, divide by width, cast to output dtype, store scalar.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _mean_kernel(\",\"    X,\",\"    Y,\",\"    stride,\",\"    N,\",\"    BLOCK_SIZE: tl.constexpr,\",\"    OUT_DTYPE: tl.constexpr,\",\"):\", \"    row = tl.program_id(0)\",\"    X += row * stride\",\"    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\",\"    for off in range(0, N, BLOCK_SIZE):\",\"        cols = off + tl.arange(0, BLOCK_SIZE)\",\"        mask = cols < N\",\"        a = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\",\"        acc += a\",\"    total = tl.sum(acc, axis=0)\",\"    mean = total / N\",\"    tl.store(Y + row, mean.to(OUT_DTYPE))\",\"\",\"\",\"def _next_pow2(n: int) -> int:\",\"    p = 1\",\"    while p < n:\",\"        p <<= 1\",\"    return p\",\"\",\"\",\"def run(x: torch.Tensor) -> torch.Tensor:\",\"    assert x.is_cuda\",\"    assert x.dim() == 2\",\"    assert x.is_contiguous()\",\"    rows, width = x.shape\",\"    y = torch.empty((rows,), dtype=x.dtype, device=x.device)\",\"    BLOCK_SIZE = _next_pow2(min(width, 2048))\",\"    grid = (rows,)\",\"    out_dtype = tl.float32 if x.dtype == torch.float32 else tl.bfloat16\",\"    _mean_kernel[grid](x, y, width, width, BLOCK_SIZE=BLOCK_SIZE, OUT_DTYPE=out_dtype)\",\"    return y\"]}",
                "request_id": "baseline-baseline-r2",

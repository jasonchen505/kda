          "contract": {
            "code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _mean_kernel(\n    X,\n    Y,\n    stride,\n    N,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride\n    Y += row\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        a = tl.load(X + cols, mask=mask, other=0.0).to(tl.float32)\n        acc += a\n    mean = tl.sum(acc, axis=0) / N\n    tl.store(Y, mean)\n\n\ndef run(x):\n    rows, width = x.shape\n    out = torch.empty(rows, dtype=x.dtype, device=x.device)\n    BLOCK_SIZE = triton.next_power_of_2(width)\n    grid = (rows,)\n    _mean_kernel[grid](x, out, width, width, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n",
            "draft": "Output shape (rows,). Stride 1. Output coord r maps to input row r, cols 0..width-1. Flat offset r*width+c. Check (0,0)->0; (0,width-1)->width-1. Sum masked cols, divide by actual width. Cast to x.dtype before store.",

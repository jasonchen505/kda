                "plan": "1) Persistent grid over rows. 2) Load row, mask, cast to fp32. 3) max, exp, sum, divide. 4) Store masked. 5) Allocate fresh contiguous out, return.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    input_ptr,\n    output_ptr,\n    n_rows,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n    NUM_SMS: tl.constexpr,\n    num_stages: tl.constexpr,\n):\n    row_start = tl.program_id(0)\n    row_step = tl.num_programs(0)\n    for row_idx in tl.range(row_start, n_rows, row_step, num_stages=num_stages):\n        col_offsets = tl.arange(0, BLOCK_SIZE)\n        mask = col_offsets < n_cols\n        input_ptrs = input_ptr + row_idx * n_cols + col_offsets\n        row = tl.load(input_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\n        row_max = tl.max(row, axis=0)\n        numerator = tl.exp(row - row_max)\n        denominator = tl.sum(numerator, axis=0)\n        result = numerator / denominator\n        output_ptrs = output_ptr + row_idx * n_cols + col_offsets\n        tl.store(output_ptrs, result, mask=mask)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(n_cols)\n    NUM_SMS = torch.cuda.get_device_properties(x.device).multi_processor_count\n    grid = (min(NUM_SMS, n_rows),)\n    _softmax_kernel[grid](x, out, n_rows, n_cols, BLOCK_SIZE=BLOCK_SIZE, NUM_SMS=NUM_SMS, num_stages=2)\n    return out\n",
                "reply": "{\"draft\":\"Single-pass row softmax. Use a persistent grid (one program per SM) to cut launch overhead on tiny row counts. Load once, compute max/exp/sum in FP32, store masked.\",\"plan\":\"1) Persistent grid over rows. 2) Load row, mask, cast to fp32. 3) max, exp, sum, divide. 4) Store masked. 5) Allocate fresh contiguous out, return.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _softmax_kernel(\",\"    input_ptr,\",\"    output_ptr,\",\"    n_rows,\",\"    n_cols,\",\"    BLOCK_SIZE: tl.constexpr,\",\"    NUM_SMS: tl.constexpr,\",\"    num_stages: tl.constexpr,\",\"):\",\"    row_start = tl.program_id(0)\",\"    row_step = tl.num_programs(0)\",\"    for row_idx in tl.range(row_start, n_rows, row_step, num_stages=num_stages):\",\"        col_offsets = tl.arange(0, BLOCK_SIZE)\",\"        mask = col_offsets < n_cols\",\"        input_ptrs = input_ptr + row_idx * n_cols + col_offsets\",\"        row = tl.load(input_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\",\"        row_max = tl.max(row, axis=0)\",\"        numerator = tl.exp(row - row_max)\",\"        denominator = tl.sum(numerator, axis=0)\",\"        result = numerator / denominator\",\"        output_ptrs = output_ptr + row_idx * n_cols + col_offsets\",\"        tl.store(output_ptrs, result, mask=mask)\",\"\",\"\",\"def run(x: torch.Tensor) -> torch.Tensor:\",\"    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\",\"    n_rows, n_cols = x.shape\",\"    out = torch.empty_like(x)\",\"    BLOCK_SIZE = triton.next_power_of_2(n_cols)\",\"    NUM_SMS = torch.cuda.get_device_properties(x.device).multi_processor_count\",\"    grid = (min(NUM_SMS, n_rows),)\",\"    _softmax_kernel[grid](x, out, n_rows, n_cols, BLOCK_SIZE=BLOCK_SIZE, NUM_SMS=NUM_SMS, num_stages=2)\",\"    return out\"]}",
                "request_id": "baseline-baseline-r1",
                "source_sha256": "c142b1ed3ebdcdcab87e8fbb2bf578034eb22fa853c7f98faaa6870717b314d4"
              },
              {
                "code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    input_ptr,\n    output_ptr,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row_idx = tl.program_id(0)\n    col_offsets = tl.arange(0, BLOCK_SIZE)\n    mask = col_offsets < n_cols\n    row_ptrs = input_ptr + row_idx * n_cols + col_offsets\n    row = tl.load(row_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\n    row_max = tl.max(row, axis=0)\n    numerator = tl.exp(row - row_max)\n    denominator = tl.sum(numerator, axis=0)\n    result = numerator / denominator\n    out_ptrs = output_ptr + row_idx * n_cols + col_offsets\n    tl.store(out_ptrs, result, mask=mask)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(n_cols)\n    grid = (n_rows,)\n    _softmax_kernel[grid](x, out, n_cols, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n",
                "draft": "One program per row; vectorized load, FP32 max/exp/sum, masked store. Avoid persistent loop and extra host work to cut launch overhead on small shapes.",

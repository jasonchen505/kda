                "parent_sha256": null,
                "plan": "Allocate contiguous output. Launch grid over rows. Kernel loads row, masks, reduces, stores.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _softmax_kernel(\n    input_ptr, output_ptr, n_cols, BLOCK_SIZE: tl.constexpr\n):\n    row_idx = tl.program_id(0)\n    col_offsets = tl.arange(0, BLOCK_SIZE)\n    mask = col_offsets < n_cols\n    input_ptrs = input_ptr + row_idx * n_cols + col_offsets\n    output_ptrs = output_ptr + row_idx * n_cols + col_offsets\n    row = tl.load(input_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\n    row_max = tl.max(row, axis=0)\n    numerator = tl.exp(row - row_max)\n    denominator = tl.sum(numerator, axis=0)\n    result = numerator / denominator\n    tl.store(output_ptrs, result, mask=mask)\n\ndef run(x):\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(n_cols)\n    _softmax_kernel[(n_rows,)](x, out, n_cols, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n",
                "reply": "{\n  \"draft\": \"Single-block row softmax. Load row with mask, compute max/exp/sum in FP32, store to fresh output.\",\n  \"plan\": \"Allocate contiguous output. Launch grid over rows. Kernel loads row, masks, reduces, stores.\",\n  \"code_lines\": [\n    \"import torch\",\n    \"import triton\",\n    \"import triton.language as tl\",\n    \"\",\n    \"@triton.jit\",\n    \"def _softmax_kernel(\",\n    \"    input_ptr, output_ptr, n_cols, BLOCK_SIZE: tl.constexpr\",\n    \"):\",\n    \"    row_idx = tl.program_id(0)\",\n    \"    col_offsets = tl.arange(0, BLOCK_SIZE)\",\n    \"    mask = col_offsets < n_cols\",\n    \"    input_ptrs = input_ptr + row_idx * n_cols + col_offsets\",\n    \"    output_ptrs = output_ptr + row_idx * n_cols + col_offsets\",\n    \"    row = tl.load(input_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\",\n    \"    row_max = tl.max(row, axis=0)\",\n    \"    numerator = tl.exp(row - row_max)\",\n    \"    denominator = tl.sum(numerator, axis=0)\",\n    \"    result = numerator / denominator\",\n    \"    tl.store(output_ptrs, result, mask=mask)\",\n    \"\",\n    \"def run(x):\",\n    \"    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\",\n    \"    n_rows, n_cols = x.shape\",\n    \"    out = torch.empty_like(x)\",\n    \"    BLOCK_SIZE = triton.next_power_of_2(n_cols)\",\n    \"    _softmax_kernel[(n_rows,)](x, out, n_cols, BLOCK_SIZE=BLOCK_SIZE)\",\n    \"    return out\"\n  ]\n}",
                "request_id": "contract-baseline-r1",
                "source_sha256": "dc22a63f64536d11118a2aaa48c086cdeb1fe3856a3f5be0228b993494ac8e34"
              },
              {
                "code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    input_ptr, output_ptr, n_cols, BLOCK_SIZE: tl.constexpr\n):\n    row_idx = tl.program_id(0)\n    col_offsets = tl.arange(0, BLOCK_SIZE)\n    mask = col_offsets < n_cols\n    input_ptrs = input_ptr + row_idx * n_cols + col_offsets\n    output_ptrs = output_ptr + row_idx * n_cols + col_offsets\n    row = tl.load(input_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\n    row_max = tl.max(row, axis=0)\n    numerator = tl.exp(row - row_max)\n    denominator = tl.sum(numerator, axis=0)\n    result = numerator / denominator\n    tl.store(output_ptrs, result, mask=mask)\n\n\ndef run(x):\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(n_cols)\n    num_warps = 4 if BLOCK_SIZE <= 512 else 8\n    _softmax_kernel[(n_rows,)](x, out, n_cols, BLOCK_SIZE=BLOCK_SIZE, num_warps=num_warps)\n    return out\n",
                "draft": "Single-pass row softmax. One program per row. Load row as FP32, subtract max, exp, sum, divide, store. Masked for odd cols. Tune num_warps per width.",

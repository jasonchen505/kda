                "plan": "Host: allocate out, pick BLOCK=4096 if width>2048 else next_pow2. Kernel: one or two passes, fp32 sum, rsqrt, cast normalized to input dtype, multiply weight, store. Grid rows.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _rmsnorm_kernel(\n    X,\n    W,\n    Y,\n    stride_x,\n    stride_y,\n    width,\n    eps,\n    BLOCK: tl.constexpr,\n    IS_BF16: tl.constexpr,\n    IS_F32: tl.constexpr,\n    SINGLE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    x_ptr = X + row * stride_x\n    y_ptr = Y + row * stride_y\n    if SINGLE:\n        cols = tl.arange(0, BLOCK)\n        mask = cols < width\n        x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\n        sum_x2 = tl.sum(x * x, axis=0)\n        mean_x2 = sum_x2 / width\n        rstd = tl.rsqrt(mean_x2 + eps)\n        normalized = x * rstd\n        if IS_BF16:\n            normalized = normalized.to(tl.bfloat16)\n        elif IS_F32:\n            normalized = normalized.to(tl.float32)\n        w = tl.load(W + cols, mask=mask, other=0.0)\n        y = w * normalized\n        tl.store(y_ptr + cols, y, mask=mask)\n    else:\n        acc = tl.zeros([BLOCK], dtype=tl.float32)\n        for off in range(0, width, BLOCK):\n            cols = off + tl.arange(0, BLOCK)\n            mask = cols < width\n            x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\n            acc += x * x\n        sum_x2 = tl.sum(acc, axis=0)\n        mean_x2 = sum_x2 / width\n        rstd = tl.rsqrt(mean_x2 + eps)\n        for off in range(0, width, BLOCK):\n            cols = off + tl.arange(0, BLOCK)\n            mask = cols < width\n            x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\n            normalized = x * rstd\n            if IS_BF16:\n                normalized = normalized.to(tl.bfloat16)\n            elif IS_F32:\n                normalized = normalized.to(tl.float32)\n            w = tl.load(W + cols, mask=mask, other=0.0)\n            y = w * normalized\n            tl.store(y_ptr + cols, y, mask=mask)\n\n\ndef run(x, weight):\n    rows, width = x.shape\n    out = torch.empty_like(x)\n    is_bf16 = x.dtype == torch.bfloat16\n    is_f32 = x.dtype == torch.float32\n    if width > 2048:\n        BLOCK = 4096\n        SINGLE = True\n    else:\n        BLOCK = triton.next_power_of_2(width)\n        SINGLE = False\n    grid = (rows,)\n    _rmsnorm_kernel[grid](\n        x,\n        weight,\n        out,\n        width,\n        width,\n        width,\n        1e-6,\n        BLOCK=BLOCK,\n        IS_BF16=is_bf16,\n        IS_F32=is_f32,\n        SINGLE=SINGLE,\n    )\n    return out\n",
                "reply": "{\"draft\":\"Fuse RMSNorm into one pass. Use a single 4096-wide block to avoid two loads for large widths; loop for smaller widths. Preserve bf16/fp32 cast before weight multiply.\",\"plan\":\"Host: allocate out, pick BLOCK=4096 if width>2048 else next_pow2. Kernel: one or two passes, fp32 sum, rsqrt, cast normalized to input dtype, multiply weight, store. Grid rows.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _rmsnorm_kernel(\",\"    X,\",\"    W,\",\"    Y,\",\"    stride_x,\",\"    stride_y,\",\"    width,\",\"    eps,\",\"    BLOCK: tl.constexpr,\",\"    IS_BF16: tl.constexpr,\",\"    IS_F32: tl.constexpr,\",\"    SINGLE: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    x_ptr = X + row * stride_x\",\"    y_ptr = Y + row * stride_y\",\"    if SINGLE:\",\"        cols = tl.arange(0, BLOCK)\",\"        mask = cols < width\",\"        x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\",\"        sum_x2 = tl.sum(x * x, axis=0)\",\"        mean_x2 = sum_x2 / width\",\"        rstd = tl.rsqrt(mean_x2 + eps)\",\"        normalized = x * rstd\",\"        if IS_BF16:\",\"            normalized = normalized.to(tl.bfloat16)\",\"        elif IS_F32:\",\"            normalized = normalized.to(tl.float32)\",\"        w = tl.load(W + cols, mask=mask, other=0.0)\",\"        y = w * normalized\",\"        tl.store(y_ptr + cols, y, mask=mask)\",\"    else:\",\"        acc = tl.zeros([BLOCK], dtype=tl.float32)\",\"        for off in range(0, width, BLOCK):\",\"            cols = off + tl.arange(0, BLOCK)\",\"            mask = cols < width\",\"            x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\",\"            acc += x * x\",\"        sum_x2 = tl.sum(acc, axis=0)\",\"        mean_x2 = sum_x2 / width\",\"        rstd = tl.rsqrt(mean_x2 + eps)\",\"        for off in range(0, width, BLOCK):\",\"            cols = off + tl.arange(0, BLOCK)\",\"            mask = cols < width\",\"            x = tl.load(x_ptr + cols, mask=mask, other=0.0).to(tl.float32)\",\"            normalized = x * rstd\",\"            if IS_BF16:\",\"                normalized = normalized.to(tl.bfloat16)\",\"            elif IS_F32:\",\"                normalized = normalized.to(tl.float32)\",\"            w = tl.load(W + cols, mask=mask, other=0.0)\",\"            y = w * normalized\",\"            tl.store(y_ptr + cols, y, mask=mask)\",\"\",\"\",\"def run(x, weight):\",\"    rows, width = x.shape\",\"    out = torch.empty_like(x)\",\"    is_bf16 = x.dtype == torch.bfloat16\",\"    is_f32 = x.dtype == torch.float32\",\"    if width > 2048:\",\"        BLOCK = 4096\",\"        SINGLE = True\",\"    else:\",\"        BLOCK = triton.next_power_of_2(width)\",\"        SINGLE = False\",\"    grid = (rows,)\",\"    _rmsnorm_kernel[grid](\",\"        x,\",\"        weight,\",\"        out,\",\"        width,\",\"        width,\",\"        width,\",\"        1e-6,\",\"        BLOCK=BLOCK,\",\"        IS_BF16=is_bf16,\",\"        IS_F32=is_f32,\",\"        SINGLE=SINGLE,\",\"    )\",\"    return out\"]}",
                "request_id": "contract-baseline-r2",

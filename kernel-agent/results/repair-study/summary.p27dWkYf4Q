                "parent_sha256": "dc22a63f64536d11118a2aaa48c086cdeb1fe3856a3f5be0228b993494ac8e34",
                "plan": "Grid=(rows,). BLOCK=next_pow2(cols). num_warps=4 for cols<=512 else 8. Load masked with -inf. FP32 math. Store masked. No loops.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    input_ptr, output_ptr, n_cols, BLOCK_SIZE: tl.constexpr\n):\n    row_idx = tl.program_id(0)\n    col_offsets = tl.arange(0, BLOCK_SIZE)\n    mask = col_offsets < n_cols\n    input_ptrs = input_ptr + row_idx * n_cols + col_offsets\n    output_ptrs = output_ptr + row_idx * n_cols + col_offsets\n    row = tl.load(input_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\n    row_max = tl.max(row, axis=0)\n    numerator = tl.exp(row - row_max)\n    denominator = tl.sum(numerator, axis=0)\n    result = numerator / denominator\n    tl.store(output_ptrs, result, mask=mask)\n\n\ndef run(x):\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(n_cols)\n    num_warps = 4 if BLOCK_SIZE <= 512 else 8\n    _softmax_kernel[(n_rows,)](x, out, n_cols, BLOCK_SIZE=BLOCK_SIZE, num_warps=num_warps)\n    return out\n",
                "reply": "{\"draft\":\"Single-pass row softmax. One program per row. Load row as FP32, subtract max, exp, sum, divide, store. Masked for odd cols. Tune num_warps per width.\",\"plan\":\"Grid=(rows,). BLOCK=next_pow2(cols). num_warps=4 for cols<=512 else 8. Load masked with -inf. FP32 math. Store masked. No loops.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _softmax_kernel(\",\"    input_ptr, output_ptr, n_cols, BLOCK_SIZE: tl.constexpr\",\"):\",\"    row_idx = tl.program_id(0)\",\"    col_offsets = tl.arange(0, BLOCK_SIZE)\",\"    mask = col_offsets < n_cols\",\"    input_ptrs = input_ptr + row_idx * n_cols + col_offsets\",\"    output_ptrs = output_ptr + row_idx * n_cols + col_offsets\",\"    row = tl.load(input_ptrs, mask=mask, other=-float('inf')).to(tl.float32)\",\"    row_max = tl.max(row, axis=0)\",\"    numerator = tl.exp(row - row_max)\",\"    denominator = tl.sum(numerator, axis=0)\",\"    result = numerator / denominator\",\"    tl.store(output_ptrs, result, mask=mask)\",\"\",\"\",\"def run(x):\",\"    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\",\"    n_rows, n_cols = x.shape\",\"    out = torch.empty_like(x)\",\"    BLOCK_SIZE = triton.next_power_of_2(n_cols)\",\"    num_warps = 4 if BLOCK_SIZE <= 512 else 8\",\"    _softmax_kernel[(n_rows,)](x, out, n_cols, BLOCK_SIZE=BLOCK_SIZE, num_warps=num_warps)\",\"    return out\"]}",

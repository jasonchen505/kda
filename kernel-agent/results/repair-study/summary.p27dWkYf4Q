                "plan": "1) Host: pick BLOCK=1024, compute n_chunks=ceil(width/BLOCK). 2) If n_chunks==1, launch 1D grid. 3) Else launch 2D grid; each CTA loads its slice, sums in FP32, atomic_adds to out. 4) After kernel, multiply out by 1/width. 5) Return out.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _mean_single(\n    X,\n    Y,\n    stride_x,\n    width,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride_x\n    cols = tl.arange(0, BLOCK_SIZE)\n    mask = cols < width\n    x = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n    s = tl.sum(x, axis=0)\n    mean = s / width\n    y = mean.to(Y.dtype.element_ty)\n    tl.store(Y + row, y)\n\n\n@triton.jit\ndef _mean_multi(\n    X,\n    Y,\n    stride_x,\n    width,\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    X += row * stride_x + chunk * BLOCK_SIZE\n    cols = tl.arange(0, BLOCK_SIZE)\n    mask = cols < width - chunk * BLOCK_SIZE\n    x = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\n    s = tl.sum(x, axis=0)\n    tl.atomic_add(Y + row, s)\n\n\ndef run(x):\n    assert x.is_cuda\n    assert x.dim() == 2\n    assert x.is_contiguous()\n    rows, width = x.shape\n    out = torch.zeros((rows,), dtype=torch.float32, device=x.device)\n    BLOCK = 1024\n    n_chunks = triton.cdiv(width, BLOCK)\n    if n_chunks == 1:\n        BLOCK_SIZE = triton.next_power_of_2(width)\n        grid = (rows,)\n        _mean_single[grid](x, out, x.stride(0), width, BLOCK_SIZE=BLOCK_SIZE)\n        out = out.to(x.dtype)\n    else:\n        grid = (rows, n_chunks)\n        _mean_multi[grid](x, out, x.stride(0), width, BLOCK_SIZE=BLOCK)\n        out = (out / width).to(x.dtype)\n    return out\n",
                "reply": "{\"draft\":\"Use 2D grid (rows, chunks) with atomic_add to split wide rows across CTAs. Small widths use single CTA. Reduces latency for worst shape [256,4096] while preserving correctness for odd sizes.\",\"plan\":\"1) Host: pick BLOCK=1024, compute n_chunks=ceil(width/BLOCK). 2) If n_chunks==1, launch 1D grid. 3) Else launch 2D grid; each CTA loads its slice, sums in FP32, atomic_adds to out. 4) After kernel, multiply out by 1/width. 5) Return out.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _mean_single(\",\"    X,\",\"    Y,\",\"    stride_x,\",\"    width,\",\"    BLOCK_SIZE: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    X += row * stride_x\",\"    cols = tl.arange(0, BLOCK_SIZE)\",\"    mask = cols < width\",\"    x = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\",\"    s = tl.sum(x, axis=0)\",\"    mean = s / width\",\"    y = mean.to(Y.dtype.element_ty)\",\"    tl.store(Y + row, y)\",\"\",\"\",\"@triton.jit\",\"def _mean_multi(\",\"    X,\",\"    Y,\",\"    stride_x,\",\"    width,\",\"    BLOCK_SIZE: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    chunk = tl.program_id(1)\",\"    X += row * stride_x + chunk * BLOCK_SIZE\",\"    cols = tl.arange(0, BLOCK_SIZE)\",\"    mask = cols < width - chunk * BLOCK_SIZE\",\"    x = tl.load(X + cols, mask=mask, other=0.).to(tl.float32)\",\"    s = tl.sum(x, axis=0)\",\"    tl.atomic_add(Y + row, s)\",\"\",\"\",\"def run(x):\",\"    assert x.is_cuda\",\"    assert x.dim() == 2\",\"    assert x.is_contiguous()\",\"    rows, width = x.shape\",\"    out = torch.zeros((rows,), dtype=torch.float32, device=x.device)\",\"    BLOCK = 1024\",\"    n_chunks = triton.cdiv(width, BLOCK)\",\"    if n_chunks == 1:\",\"        BLOCK_SIZE = triton.next_power_of_2(width)\",\"        grid = (rows,)\",\"        _mean_single[grid](x, out, x.stride(0), width, BLOCK_SIZE=BLOCK_SIZE)\",\"        out = out.to(x.dtype)\",\"    else:\",\"        grid = (rows, n_chunks)\",\"        _mean_multi[grid](x, out, x.stride(0), width, BLOCK_SIZE=BLOCK)\",\"        out = (out / width).to(x.dtype)\",\"    return out\"]}",

                "plan": "Allocate contiguous output. Launch one program per row. Load row, subtract max, exp, sum, divide, store. Tune num_warps by column count to beat torch.compile on worst shapes.",
                "proposed_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _softmax_kernel(\n    input_ptr,\n    output_ptr,\n    n_cols,\n    BLOCK_SIZE: tl.constexpr,\n    IS_BF16: tl.constexpr,\n):\n    row = tl.program_id(0)\n    col_offsets = tl.arange(0, BLOCK_SIZE)\n    mask = col_offsets < n_cols\n    in_ptrs = input_ptr + row * n_cols + col_offsets\n    row_vals = tl.load(in_ptrs, mask=mask, other=-float('inf'))\n    row_f32 = row_vals.to(tl.float32)\n    row_max = tl.max(row_f32, axis=0)\n    exp_vals = tl.exp(row_f32 - row_max)\n    denom = tl.sum(exp_vals, axis=0)\n    out_vals = exp_vals / denom\n    if IS_BF16:\n        out_vals = out_vals.to(tl.bfloat16)\n    out_ptrs = output_ptr + row * n_cols + col_offsets\n    tl.store(out_ptrs, out_vals, mask=mask)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\n    n_rows, n_cols = x.shape\n    out = torch.empty_like(x)\n    BLOCK_SIZE = triton.next_power_of_2(n_cols)\n    grid = (n_rows,)\n    if n_cols >= 1024:\n        num_warps = 8\n    elif n_cols >= 512:\n        num_warps = 4\n    else:\n        num_warps = 2\n    _softmax_kernel[grid](x, out, n_cols, BLOCK_SIZE=BLOCK_SIZE, IS_BF16=(x.dtype == torch.bfloat16), num_warps=num_warps)\n    return out\n",
                "reply": "{\"draft\":\"Single-pass row softmax. Use num_warps=8 for large rows to hide latency. Keep FP32 math, mask padded lanes, and write in original dtype.\",\"plan\":\"Allocate contiguous output. Launch one program per row. Load row, subtract max, exp, sum, divide, store. Tune num_warps by column count to beat torch.compile on worst shapes.\",\"code_lines\":[\"import torch\",\"import triton\",\"import triton.language as tl\",\"\",\"\",\"@triton.jit\",\"def _softmax_kernel(\",\"    input_ptr,\",\"    output_ptr,\",\"    n_cols,\",\"    BLOCK_SIZE: tl.constexpr,\",\"    IS_BF16: tl.constexpr,\",\"):\",\"    row = tl.program_id(0)\",\"    col_offsets = tl.arange(0, BLOCK_SIZE)\",\"    mask = col_offsets < n_cols\",\"    in_ptrs = input_ptr + row * n_cols + col_offsets\",\"    row_vals = tl.load(in_ptrs, mask=mask, other=-float('inf'))\",\"    row_f32 = row_vals.to(tl.float32)\",\"    row_max = tl.max(row_f32, axis=0)\",\"    exp_vals = tl.exp(row_f32 - row_max)\",\"    denom = tl.sum(exp_vals, axis=0)\",\"    out_vals = exp_vals / denom\",\"    if IS_BF16:\",\"        out_vals = out_vals.to(tl.bfloat16)\",\"    out_ptrs = output_ptr + row * n_cols + col_offsets\",\"    tl.store(out_ptrs, out_vals, mask=mask)\",\"\",\"\",\"def run(x: torch.Tensor) -> torch.Tensor:\",\"    assert x.is_cuda and x.dim() == 2 and x.is_contiguous()\",\"    n_rows, n_cols = x.shape\",\"    out = torch.empty_like(x)\",\"    BLOCK_SIZE = triton.next_power_of_2(n_cols)\",\"    grid = (n_rows,)\",\"    if n_cols >= 1024:\",\"        num_warps = 8\",\"    elif n_cols >= 512:\",\"        num_warps = 4\",\"    else:\",\"        num_warps = 2\",\"    _softmax_kernel[grid](x, out, n_cols, BLOCK_SIZE=BLOCK_SIZE, IS_BF16=(x.dtype == torch.bfloat16), num_warps=num_warps)\",\"    return out\"]}",

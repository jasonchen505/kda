{"attempts":[{"code":"import torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _row_sum_kernel(\n    X,  # pointer to input\n    Y,  # pointer to output\n    stride_x,  # row stride of input\n    N,  # number of columns\n    BLOCK_SIZE: tl.constexpr,\n):\n    row = tl.program_id(0)\n    X += row * stride_x\n    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n    for off in range(0, N, BLOCK_SIZE):\n        cols = off + tl.arange(0, BLOCK_SIZE)\n        mask = cols < N\n        x = tl.load(X + cols, mask=mask, other=0.0).to(tl.float32)\n        acc += x\n    result = tl.sum(acc, axis=0)\n    Y += row\n    tl.store(Y, result)\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    assert x.is_cuda, \"Input must be a CUDA tensor\"\n    assert x.dim() == 2, \"Input must be 2D\"\n    assert x.is_contiguous(), \"Input must be contiguous\"\n    rows, cols = x.shape\n    out = torch.empty(rows, dtype=x.dtype, device=x.device)\n    if rows == 0:\n        return out\n    BLOCK_SIZE = triton.next_power_of_2(cols)\n    grid = (rows,)\n    _row_sum_kernel[grid](x, out, x.stride(0), cols, BLOCK_SIZE=BLOCK_SIZE)\n    return out\n","draft":"Output shape (rows,), stride 1. Input stride (cols, 1). Row r maps to input offset r*cols. For r=0, c=0: offset 0. For r=1, c=cols-1: offset cols + (cols-1). Sum input row in FP32, cast to output dtype.","evaluation":{"checks_passed":28,"cooperative_queue":{"lock_file":"/data/home/chenyizhou/kernel-agent-repair-experiment-v2/gpu4.lock","pid":2417311,"scope":"serializes this project's workers only","wait_seconds":5.86318152025342},"device_audit":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"device_binding":{"actual":{"device_count":1,"device_index":0,"gpu_uuid":"c3d8eae9-15d0-678b-0245-1cea79503b50","visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50"},"child_visible_devices":"GPU-c3d8eae9-15d0-678b-0245-1cea79503b50","expe